@model VatTu
@{ ViewData["Title"] = "Thẻ kho " + Model.Ma; var dong = (List<TheKho>)ViewBag.DongThe; var sd = (List<ChiTietVatTuSuaChua>)ViewBag.SuDung; }
<div class="small text-muted mb-1"><a asp-action="Index">Kho vật tư</a> › Thẻ kho</div>
<div class="page-head"><h1>Thẻ kho: @Model.Ma · @Model.Ten</h1>
    <form method="get" class="d-flex gap-2 ms-2"><input type="hidden" name="vatTuId" value="@Model.Id" /><select name="khoId" asp-items="ViewBag.DsKho" class="form-select form-select-sm" aria-label="Kho"><option value="">— Mọi kho —</option></select><button class="btn btn-sm btn-outline-secondary">Lọc</button></form></div>
<div class="small text-muted mb-3">Tổng tồn @Model.TonKho.ToString("0.##") @Model.DonViTinh · đơn giá bình quân @Model.DonGia.ToString("N0") đ · tối thiểu @Model.TonToiThieu.ToString("0.##") / tối đa @Model.TonToiDa.ToString("0.##")</div>
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="table-responsive" style="max-height:620px"><table class="table table-sm mb-0">
        <thead class="sticky-top"><tr><th>Thời gian</th><th>Kho</th><th>Chứng từ / diễn giải</th><th class="text-end">Nhập</th><th class="text-end">Xuất</th><th class="text-end">Tồn sau</th></tr></thead>
        <tbody>@foreach (var t in dong) {
            <tr><td class="small text-nowrap">@t.ThoiGian.ToString("dd/MM/yy HH:mm")</td><td class="small">@t.Kho?.Ma</td><td class="small"><a asp-action="ChiTiet" asp-route-id="@t.PhieuKhoId">@t.DienGiai</a></td>
                <td class="text-end text-success">@(t.Nhap == 0 ? "" : t.Nhap.ToString("0.##"))</td><td class="text-end text-danger">@(t.Xuat == 0 ? "" : t.Xuat.ToString("0.##"))</td><td class="text-end fw-semibold">@t.TonSau.ToString("0.##")</td></tr> }
            @if (dong.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-3">Chưa có biến động (tồn đầu kỳ chuyển từ dữ liệu cũ).</td></tr> }
        </tbody></table></div></div></div>
    <div class="col-lg-4"><div class="card"><div class="card-header">Đã dùng cho phiếu sửa chữa</div><div class="list-group list-group-flush">
        @foreach (var c in sd) { <a class="list-group-item list-group-item-action small" asp-controller="PhieuSuaChua" asp-action="Details" asp-route-id="@c.PhieuSuaChuaId"><b>@c.PhieuSuaChua?.SoPhieu</b> · @c.SoLuong.ToString("0.##") · @c.PhieuSuaChua?.TaiSan?.MaTaiSan · @c.PhieuSuaChua?.KyThuatVien</a> }
        @if (sd.Count == 0) { <div class="list-group-item small text-muted">Chưa dùng.</div> }
    </div></div></div>
</div>
