@model List<MucDiDong>
@{ ViewData["Title"] = "Trang chủ"; var them = (List<MucDiDong>)ViewBag.Them; var dem = (Dictionary<string, int>)ViewBag.Dem; }
<div class="d-flex align-items-center mb-3">
    <div><div class="small text-muted">Xin chào</div><h1 class="h5 mb-0">@User.HoTen()</h1></div>
    <a href="/" class="btn btn-sm btn-link ms-auto d-none d-lg-inline">Giao diện đầy đủ</a>
</div>
<div class="row g-2 mb-4">
    @for (var i = 0; i < Model.Count; i++)
    {
        var m = Model[i];
        <div class="@(i == 0 ? "col-12" : "col-6")"><a href="@m.Url" class="o-didong @(i == 0 ? "chinh " + m.Ma : "")">
            <i class="bi @m.Icon"></i>
            @if (dem.GetValueOrDefault(m.Ma) > 0) { <span class="badge rounded-pill bg-@(i == 0 ? "light text-dark" : "danger") so">@dem[m.Ma]</span> }
            <div><div class="fw-semibold">@m.Ten</div><div class="small @(i == 0 ? "" : "text-muted")">@m.MoTa</div></div>
        </a></div>
    }
</div>
@if (them.Count > 0)
{
    <div class="small text-muted text-uppercase mb-2">Chức năng khác</div>
    <div class="list-group mb-3">
        @foreach (var m in them)
        {
            <a href="@m.Url" class="list-group-item list-group-item-action d-flex align-items-center gap-3"><i class="bi @m.Icon fs-5 text-primary"></i>
                <span class="flex-grow-1">@m.Ten<div class="small text-muted">@m.MoTa</div></span>
                @if (dem.GetValueOrDefault(m.Ma) > 0) { <span class="badge rounded-pill bg-danger">@dem[m.Ma]</span> }<i class="bi bi-chevron-right text-muted"></i></a>
        }
    </div>
}
<div class="small text-muted text-center" id="goiYCai" hidden>
    <button class="btn btn-sm btn-outline-primary" id="btnCai"><i class="bi bi-phone"></i> Cài ứng dụng lên màn hình chính</button>
</div>
@section Scripts {
<script>
let suKienCai = null;
window.addEventListener('beforeinstallprompt', e => { e.preventDefault(); suKienCai = e; document.getElementById('goiYCai').hidden = false; });
document.getElementById('btnCai').onclick = async () => { if (!suKienCai) return; suKienCai.prompt(); await suKienCai.userChoice; suKienCai = null; document.getElementById('goiYCai').hidden = true; };
</script>
}
