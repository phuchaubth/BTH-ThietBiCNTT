@model List<ThietBiCNTT.Web.Controllers.ViecChoDuyet>
@{ ViewData["Title"] = "Chờ tôi xử lý"; }
<h1 class="h5 mb-3"><i class="bi bi-check2-square"></i> Chờ tôi xử lý <span class="badge bg-secondary">@Model.Count</span></h1>
<div class="list-group">
    @foreach (var x in Model)
    {
        <a href="@x.Url" class="list-group-item list-group-item-action">
            <div class="d-flex"><span class="badge bg-light text-dark border me-2">@x.Loai</span><b>@x.So</b><span class="ms-auto small text-muted">@x.ThoiGian.ToString("dd/MM")</span></div>
            <div class="small text-truncate mt-1">@x.NoiDung</div>
        </a>
    }
    @if (Model.Count == 0) { <div class="list-group-item text-center text-muted py-4"><i class="bi bi-emoji-smile fs-3 d-block"></i>Không có việc nào chờ bạn.</div> }
</div>
