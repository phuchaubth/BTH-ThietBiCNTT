@model HanhDongKhacPhuc
@{
    ViewData["Title"] = Model.Ma; var homNay = (DateOnly)ViewBag.HomNay; string link = ViewBag.LinkNguon; var hoTen = (Dictionary<string, string>)ViewBag.HoTen; bool duocDuyet = ViewBag.DuocDuyet;
    var laNguoi = string.Equals(Model.NguoiChiuTrachNhiem, User.Identity!.Name, StringComparison.OrdinalIgnoreCase) || User.IsInRole(VaiTro.QuanTri); var cntt = User.LaCNTT();
    var khacNguoi = !string.Equals(Model.NguoiChiuTrachNhiem, User.Identity!.Name, StringComparison.OrdinalIgnoreCase);
}
<div class="small text-muted mb-1"><a asp-action="Index">Hành động khắc phục</a> › @Model.Ma</div>
<div class="page-head"><h1>@Model.Ma · @Model.Loai.Ten()</h1> @Html.Raw(Badge.Html(Model.TrangThai)) @Html.Raw(Badge.Html(Model.UuTien)) @if (Model.QuaHan(homNay)) { <span class="badge bg-danger">Quá hạn @(homNay.DayNumber - Model.Han.DayNumber) ngày</span> }</div>
<div class="row g-3"><div class="col-lg-8">
    <div class="card mb-3"><div class="card-body"><dl class="row info mb-0">
        <div class="col-12"><dt>Nội dung</dt><dd style="white-space:pre-line">@Model.MoTa</dd></div>
        <div class="col-sm-4"><dt>Nguồn</dt><dd>@Model.Nguon.Ten() @if (link.Length > 0) { <a href="@link">xem</a> }</dd></div>
        <div class="col-sm-4"><dt>Hệ thống</dt><dd>@if (Model.HeThong is not null) { <a asp-controller="HeThong" asp-action="Details" asp-route-id="@Model.HeThongId">@Model.HeThong.Ma</a> }</dd></div>
        <div class="col-sm-4"><dt>Hạn</dt><dd>@Model.Han.ToString("dd/MM/yyyy")</dd></div>
        <div class="col-sm-6"><dt>Người chịu trách nhiệm</dt><dd>@hoTen.TenNguoi(Model.NguoiChiuTrachNhiem)</dd></div>
        <div class="col-sm-6"><dt>Tạo bởi</dt><dd>@Model.NguoiTao @Model.NgayTao.ToString("dd/MM/yyyy")</dd></div>
        @if (Model.KetQuaThucHien is not null) { <div class="col-12"><dt>Kết quả thực hiện (@Model.NgayHoanThanh?.ToString("dd/MM/yyyy"))</dt><dd style="white-space:pre-line">@Model.KetQuaThucHien</dd></div> }
        @if (Model.BangChungHieuQua is not null) { <div class="col-12"><dt>Bằng chứng hiệu quả — @hoTen.TenNguoi(Model.NguoiKiemChung) @Model.NgayKiemChung?.ToString("dd/MM/yyyy")</dt><dd style="white-space:pre-line">@Model.BangChungHieuQua</dd></div> }
        @if (Model.LichSuGiaHan is not null) { <div class="col-12"><dt>Lịch sử gia hạn / kiểm chứng</dt><dd style="white-space:pre-line" class="small">@Model.LichSuGiaHan</dd></div> }
    </dl></div></div>
    @if (Model.TrangThai is TrangThaiHanhDong.Mo or TrangThaiHanhDong.DangLam && laNguoi)
    {
        <div class="card mb-3 border-primary"><div class="card-header">Thực hiện</div><div class="card-body">
            @if (Model.TrangThai == TrangThaiHanhDong.Mo) { <form asp-action="BatDau" asp-route-id="@Model.Id" method="post" class="mb-3"><button class="btn btn-sm btn-outline-primary">Bắt đầu làm</button></form> }
            <form asp-action="BaoCaoXong" asp-route-id="@Model.Id" method="post"><label class="form-label small mb-0" for="kq">Kết quả thực hiện</label><textarea id="kq" name="ketQua" class="form-control form-control-sm mb-2" rows="3" required></textarea><button class="btn btn-sm btn-primary">Báo hoàn thành (chờ kiểm chứng)</button></form>
        </div></div>
    }
    @if (Model.TrangThai == TrangThaiHanhDong.ChoKiemChung)
    {
        <div class="card mb-3 border-info"><div class="card-header">Kiểm chứng hiệu quả <span class="small fw-normal text-muted">FR-HD-04 – người kiểm chứng phải khác người thực hiện</span></div><div class="card-body">
        @if (khacNguoi)
        {
            <form asp-action="KiemChung" asp-route-id="@Model.Id" method="post"><label class="form-label small mb-0" for="bc">Bằng chứng / nhận xét (ví dụ "diễn tập lại Đạt ngày …")</label><textarea id="bc" name="bangChung" class="form-control form-control-sm mb-2" rows="2" required></textarea>
                <div class="d-flex gap-2"><button name="hieuQua" value="true" class="btn btn-sm btn-success">Hiệu quả — đóng</button><button name="hieuQua" value="false" class="btn btn-sm btn-outline-danger">Chưa hiệu quả — mở lại</button></div></form>
        }
        else { <span class="small text-muted">Chờ người khác (không phải @Model.NguoiChiuTrachNhiem) kiểm chứng.</span> }
        </div></div>
    }
    @if (Model.TrangThai != TrangThaiHanhDong.DaDong && duocDuyet)
    {
        <div class="card mb-3"><div class="card-header">Gia hạn <span class="small fw-normal text-muted">FR-HD-03 – cần lý do và người duyệt khác người thực hiện</span></div><div class="card-body">
            <form asp-action="GiaHan" asp-route-id="@Model.Id" method="post" class="row g-2"><div class="col-md-3"><input name="hanMoi" type="date" class="form-control form-control-sm" required aria-label="Hạn mới" /></div><div class="col-md-7"><input name="lyDo" class="form-control form-control-sm" placeholder="Lý do gia hạn" required /></div><div class="col-md-2"><button class="btn btn-sm btn-outline-primary w-100">Gia hạn</button></div></form>
        </div></div>
    }
</div>
<div class="col-lg-4">@await Html.PartialAsync("_DinhKem", (DoiTuong: "HanhDongKhacPhuc", DoiTuongId: Model.Id.ToString(), Teps: (List<TepDinhKem>)ViewBag.Tep, DuocTaiLen: cntt && Model.TrangThai != TrangThaiHanhDong.DaDong))</div></div>
