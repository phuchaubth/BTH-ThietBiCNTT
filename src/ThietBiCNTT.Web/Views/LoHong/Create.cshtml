@model LoHong
@{ ViewData["Title"] = "Ghi nhận lỗ hổng"; }
<div class="page-head"><h1>@ViewData["Title"]</h1><span class="text-muted small">Hạn vá tự tính theo mức CVSS (tham số hệ thống)</span></div>
<div class="card" style="max-width:820px"><div class="card-body"><form asp-action="Create" method="post" class="row g-3"><div asp-validation-summary="All" class="text-danger small col-12"></div>
    <div class="col-md-8"><label asp-for="TieuDe" class="form-label"></label><input asp-for="TieuDe" class="form-control" /></div><div class="col-md-4"><label asp-for="MaCve" class="form-label"></label><input asp-for="MaCve" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="Nguon" class="form-label"></label><select asp-for="Nguon" asp-items="@EnumExtensions.ToSelectList<NguonLoHong>(Model.Nguon)" class="form-select"></select></div>
    <div class="col-md-4"><label asp-for="Cvss" class="form-label"></label><input asp-for="Cvss" type="number" step="0.1" min="0" max="10" class="form-control" /></div><div class="col-md-4"><label asp-for="NgayPhatHien" class="form-label"></label><input asp-for="NgayPhatHien" type="date" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="HeThongId" class="form-label"></label><select asp-for="HeThongId" asp-items="@((SelectList)ViewBag.DsHeThong)" class="form-select"><option value="">—</option></select></div>
    <div class="col-md-6"><label asp-for="TaiSanId" class="form-label"></label><select asp-for="TaiSanId" asp-items="@((SelectList)ViewBag.DsTaiSan)" class="form-select"><option value="">—</option></select></div>
    <div class="col-md-6"><label asp-for="NguoiPhuTrach" class="form-label"></label><input asp-for="NguoiPhuTrach" class="form-control" /></div>
    <div class="col-12"><label asp-for="GhiChu" class="form-label"></label><textarea asp-for="GhiChu" class="form-control" rows="2"></textarea></div>
    <div class="col-12"><button class="btn btn-primary">Ghi nhận</button> <a asp-action="Index" class="btn btn-link">Huỷ</a></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
