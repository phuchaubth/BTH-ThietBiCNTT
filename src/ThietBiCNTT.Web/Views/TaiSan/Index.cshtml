@model PagedList<TaiSan>
@{
    ViewData["Title"] = "Tài sản";
    var qs = Context.Request.QueryString.Value;
}
<div class="page-head">
    <h1>Tài sản & cấu hình</h1>
    <div class="actions">
        <a class="btn btn-sm btn-outline-secondary" href="/TaiSan/Export@(qs)"><i class="bi bi-file-earmark-excel"></i> Xuất Excel</a>
        <button form="frmChon" formaction="/TaiSan/InTem" class="btn btn-sm btn-outline-secondary"><i class="bi bi-qr-code"></i> In tem QR (đã chọn)</button>
        @if (User.LaCNTT()) { <a asp-action="Create" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> Thêm tài sản</a> }
    </div>
</div>
<form method="get" class="card card-body py-2 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3"><input name="q" value="@ViewData["q"]" class="form-control form-control-sm" placeholder="Mã, tên, serial, IP, hostname, người dùng…" /></div>
        <div class="col-6 col-md-2"><select name="khoa" class="form-select form-select-sm" asp-items="@(new SelectList((SelectList)ViewBag.Khoa, "Value", "Text", ViewData["khoa"]))"><option value="">— Khoa/phòng —</option></select></div>
        <div class="col-6 col-md-2"><select name="loai" class="form-select form-select-sm" asp-items="@(new SelectList((SelectList)ViewBag.Loai, "Value", "Text", ViewData["loai"]))"><option value="">— Loại —</option></select></div>
        <div class="col-6 col-md-2"><select name="trangThai" class="form-select form-select-sm" asp-items="@EnumExtensions.ToSelectList((TrangThaiTaiSan?)ViewData["trangThai"])"><option value="">— Trạng thái (trừ đã TL) —</option></select></div>
        <div class="col-6 col-md-2"><div class="form-check"><input class="form-check-input" type="checkbox" name="hetBaoHanh" value="true" id="hbh" @(ViewData["hetBaoHanh"] is true ? "checked" : "") /><label class="form-check-label small" for="hbh">Sắp hết BH (60 ngày)</label></div></div>
        <div class="col-md-1"><button class="btn btn-sm btn-primary w-100">Lọc</button></div>
    </div>
</form>
<form id="frmChon" method="get"></form>
<div class="card"><div class="table-responsive">
<table class="table table-hover mb-0 align-middle">
    <thead><tr><th><input type="checkbox" class="form-check-input" onclick="document.querySelectorAll('.chk').forEach(c=>c.checked=this.checked)" /></th><th>Mã TS</th><th>Tên / Model</th><th>Khoa/phòng</th><th>Người SD</th><th>IP / Hostname</th><th>Bảo hành</th><th>Trạng thái</th></tr></thead>
    <tbody>
    @{ var homNay = DateOnly.FromDateTime(DateTime.Today); }
    @foreach (var t in Model.Items)
    {
        <tr>
            <td><input type="checkbox" class="form-check-input chk" name="ids" value="@t.Id" form="frmChon" /></td>
            <td class="fw-semibold"><a asp-action="Details" asp-route-id="@t.Id">@t.MaTaiSan</a></td>
            <td>@t.Ten<div class="small text-muted">@t.LoaiThietBi?.Ten · SN @t.SoSerial</div></td>
            <td class="small">@t.KhoaPhong?.Ten</td>
            <td class="small">@t.NguoiSuDung</td>
            <td class="small font-monospace">@t.CauHinh?.DiaChiIP<div class="text-muted">@t.CauHinh?.Hostname</div></td>
            <td class="small">@if (t.HanBaoHanh is { } h) { <span class="@(h < homNay ? "text-muted text-decoration-line-through" : h <= homNay.AddDays(60) ? "text-warning fw-semibold" : "")">@h.ToString("dd/MM/yyyy")</span> }</td>
            <td>@Html.Raw(Badge.Html(t.TrangThai))</td>
        </tr>
    }
    @if (Model.Items.Count == 0) { <tr><td colspan="8" class="text-center text-muted py-4">Không có tài sản phù hợp.</td></tr> }
    </tbody>
</table>
</div></div>
<partial name="_Pager" model="(Model.Page, Model.TotalPages, Model.Total)" />
