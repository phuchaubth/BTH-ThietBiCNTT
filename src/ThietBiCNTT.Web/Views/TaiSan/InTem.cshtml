@model List<TaiSan>
@{ Layout = "_Print"; ViewData["Title"] = "In tem QR"; }
<style>body{font-family:Arial,sans-serif;padding:5mm}</style>
@foreach (var t in Model)
{
    <div class="qr-label" style="width:62mm;border:1px dashed #999;padding:3mm;display:inline-flex;gap:3mm;align-items:center;margin:1.5mm;page-break-inside:avoid;font-size:8.5pt">
        <img src="/TaiSan/QrImage/@t.Id" style="width:22mm;height:22mm" />
        <div><div style="font-size:7pt">@ThamSo.Chuoi(TS.TenBenhVien)</div><b style="font-size:11pt">@t.MaTaiSan</b><div>@t.Ten</div><div style="font-size:7pt">@t.KhoaPhong?.Ten</div></div>
    </div>
}
@if (Model.Count == 0) { <p>Chưa chọn tài sản nào.</p> }
