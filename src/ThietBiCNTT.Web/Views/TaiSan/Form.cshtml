@model ThietBiCNTT.Web.Controllers.TaiSanFormVm
@{
    var moi = Model.TaiSan.Id == 0;
    ViewData["Title"] = moi ? "Thêm tài sản" : "Sửa " + Model.TaiSan.MaTaiSan;
}
<div class="page-head"><h1>@ViewData["Title"]</h1></div>
<form asp-action="Save" method="post">
    <input type="hidden" asp-for="TaiSan.Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger small" ></div>
    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card"><div class="card-header">Thông tin tài sản</div><div class="card-body row g-3">
                <div class="col-md-4"><label asp-for="TaiSan.MaTaiSan" class="form-label"></label><input asp-for="TaiSan.MaTaiSan" class="form-control" placeholder="VD: PC-0123" /><span asp-validation-for="TaiSan.MaTaiSan" class="text-danger small"></span></div>
                <div class="col-md-8"><label asp-for="TaiSan.Ten" class="form-label"></label><input asp-for="TaiSan.Ten" class="form-control" /><span asp-validation-for="TaiSan.Ten" class="text-danger small"></span></div>
                <div class="col-md-4"><label asp-for="TaiSan.LoaiThietBiId" class="form-label"></label><select asp-for="TaiSan.LoaiThietBiId" asp-items="ViewBag.DsLoai" class="form-select"></select></div>
                <div class="col-md-4"><label asp-for="TaiSan.Hang" class="form-label"></label><input asp-for="TaiSan.Hang" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="TaiSan.Model" class="form-label"></label><input asp-for="TaiSan.Model" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="TaiSan.SoSerial" class="form-label"></label><input asp-for="TaiSan.SoSerial" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="TaiSan.TrangThai" class="form-label"></label><select asp-for="TaiSan.TrangThai" asp-items="@EnumExtensions.ToSelectList<TrangThaiTaiSan>()" class="form-select"></select></div>
                <div class="col-md-4"><label asp-for="TaiSan.NguonVon" class="form-label"></label><select asp-for="TaiSan.NguonVon" asp-items="@EnumExtensions.ToSelectList<NguonVon>()" class="form-select"></select></div>
                <div class="col-md-4"><label asp-for="TaiSan.NguyenGia" class="form-label"></label><input asp-for="TaiSan.NguyenGia" class="form-control" type="number" step="1000" /></div>
                <div class="col-md-4"><label asp-for="TaiSan.NgayMua" class="form-label"></label><input asp-for="TaiSan.NgayMua" class="form-control" type="date" /></div>
                <div class="col-md-4"><label asp-for="TaiSan.NgaySuDung" class="form-label"></label><input asp-for="TaiSan.NgaySuDung" class="form-control" type="date" /></div>
                <div class="col-md-4"><label asp-for="TaiSan.NhaCungCapId" class="form-label"></label><select asp-for="TaiSan.NhaCungCapId" asp-items="ViewBag.DsNcc" class="form-select"><option value="">—</option></select></div>
                <div class="col-md-4"><label asp-for="TaiSan.HanBaoHanh" class="form-label"></label><input asp-for="TaiSan.HanBaoHanh" class="form-control" type="date" /></div>
                <div class="col-md-4"><label asp-for="TaiSan.SoHopDong" class="form-label"></label><input asp-for="TaiSan.SoHopDong" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="TaiSan.KhoaPhongId" class="form-label"></label><select asp-for="TaiSan.KhoaPhongId" asp-items="ViewBag.DsKhoa" class="form-select"><option value="">— Kho CNTT —</option></select>
                    @if (!moi) { <div class="form-text">Đổi khoa/phòng phải qua phiếu điều chuyển.</div> }</div>
                <div class="col-md-6"><label asp-for="TaiSan.NguoiSuDung" class="form-label"></label><input asp-for="TaiSan.NguoiSuDung" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="TaiSan.TaiSanChaId" class="form-label"></label><select asp-for="TaiSan.TaiSanChaId" asp-items="ViewBag.DsCha" class="form-select"><option value="">—</option></select></div>
                <div class="col-md-6"><label asp-for="TaiSan.ChiSoBoDem" class="form-label"></label><input asp-for="TaiSan.ChiSoBoDem" class="form-control" type="number" /></div>
                <div class="col-12"><label asp-for="TaiSan.GhiChu" class="form-label"></label><textarea asp-for="TaiSan.GhiChu" class="form-control" rows="2"></textarea></div>
            </div></div>
        </div>
        <div class="col-lg-5">
            <div class="card"><div class="card-header">Cấu hình (máy tính / máy chủ)</div><div class="card-body row g-3">
                <div class="col-12"><label asp-for="CauHinh.CPU" class="form-label"></label><input asp-for="CauHinh.CPU" class="form-control" /></div>
                <div class="col-6"><label asp-for="CauHinh.RAM" class="form-label"></label><input asp-for="CauHinh.RAM" class="form-control" /></div>
                <div class="col-6"><label asp-for="CauHinh.OCung" class="form-label"></label><input asp-for="CauHinh.OCung" class="form-control" /></div>
                <div class="col-6"><label asp-for="CauHinh.HeDieuHanh" class="form-label"></label><input asp-for="CauHinh.HeDieuHanh" class="form-control" /></div>
                <div class="col-6"><label asp-for="CauHinh.BanQuyen" class="form-label"></label><input asp-for="CauHinh.BanQuyen" class="form-control" /></div>
                <div class="col-6"><label asp-for="CauHinh.DiaChiIP" class="form-label"></label><input asp-for="CauHinh.DiaChiIP" class="form-control font-monospace" /></div>
                <div class="col-6"><label asp-for="CauHinh.DiaChiMAC" class="form-label"></label><input asp-for="CauHinh.DiaChiMAC" class="form-control font-monospace" /></div>
                <div class="col-12"><label asp-for="CauHinh.Hostname" class="form-label"></label><input asp-for="CauHinh.Hostname" class="form-control font-monospace" /></div>
                <div class="col-12"><label asp-for="CauHinh.PhanMem" class="form-label"></label><textarea asp-for="CauHinh.PhanMem" class="form-control" rows="2"></textarea></div>
                @if (!moi) { <div class="col-12"><label asp-for="LyDoThayDoi" class="form-label">Lý do thay đổi (ghi vào lịch sử)</label><input asp-for="LyDoThayDoi" class="form-control" placeholder="VD: Nâng RAM theo phiếu SC-2611-0012" /></div> }
            </div></div>
        </div>
    </div>
    <div class="mt-3"><button class="btn btn-primary"><i class="bi bi-save"></i> Lưu</button> <a href="javascript:history.back()" class="btn btn-link">Huỷ</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
