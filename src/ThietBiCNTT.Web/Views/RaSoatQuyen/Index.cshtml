@model List<DotRaSoatQuyen>
@{ ViewData["Title"] = "Rà soát quyền truy cập"; var chiMo = (bool)ViewData["chiMo"]!; var homNay = (DateOnly)ViewBag.HomNay; var chua = (List<HeThongThongTin>)ViewBag.ChuaRaSoat; }
<div class="page-head"><h1>Rà soát quyền truy cập</h1><span class="text-muted small">MOI.01.01 – danh sách người được truy cập và mức quyền theo vai trò</span>
    <div class="actions"><a asp-controller="NghiViec" asp-action="Index" class="btn btn-sm btn-outline-secondary">Nghỉ việc / chuyển khoa</a><a asp-controller="ViPhamTruyCap" asp-action="Index" class="btn btn-sm btn-outline-secondary">Giám sát tuân thủ</a><a asp-action="Mau" class="btn btn-sm btn-outline-secondary"><i class="bi bi-download"></i> Mẫu tệp nhập</a></div></div>
@if (chua.Count > 0) { <div class="alert alert-warning py-2"><i class="bi bi-exclamation-triangle"></i> Hệ thống đến kỳ rà soát quyền: @string.Join(", ", chua.Select(h => h.Ma)).</div> }
@if (User.LaCNTT()) { <form asp-action="Tao" method="post" class="row g-2 mb-3"><div class="col-auto"><select name="heThongId" asp-items="@((SelectList)ViewBag.DsHeThong)" class="form-select form-select-sm" aria-label="Hệ thống"></select></div><div class="col-auto"><input name="lyDo" class="form-control form-control-sm" placeholder="Lý do (tuỳ chọn)" aria-label="Lý do" /></div><div class="col-auto"><button class="btn btn-sm btn-primary">Mở đợt rà soát</button></div></form> }
<div class="form-check mb-2"><a asp-action="Index" asp-route-chiMo="@(!chiMo)" class="small">@(chiMo ? "Hiện cả đợt đã đóng" : "Chỉ đợt đang mở")</a></div>
<div class="card"><div class="table-responsive"><table class="table table-sm mb-0 align-middle"><thead><tr><th>Số đợt</th><th>Hệ thống</th><th>Trạng thái</th><th>Tài khoản</th><th>Chưa xác nhận</th><th>Chưa thực hiện</th><th>Hạn</th></tr></thead><tbody>
@foreach (var d in Model) { <tr><td><a asp-action="Details" asp-route-id="@d.Id">@d.Ma</a></td><td>@d.HeThong?.Ma</td><td><span class="badge bg-@(d.TrangThai == TrangThaiRaSoat.DaDong ? "success" : "primary")">@d.TrangThai.Ten()</span></td><td>@d.TaiKhoans.Count</td><td>@d.SoChuaXacNhan</td><td>@d.SoChuaThucHien</td><td class="@(d.TrangThai != TrangThaiRaSoat.DaDong && d.Han < homNay ? "overdue" : "") small">@d.Han.ToString("dd/MM/yyyy")</td></tr> }
@if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-3">Không có đợt rà soát.</td></tr> }
</tbody></table></div></div>
