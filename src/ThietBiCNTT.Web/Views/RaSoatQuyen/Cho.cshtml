@model List<DotRaSoatQuyen>
@{ ViewData["Title"] = "Rà soát quyền truy cập chờ xác nhận"; var k = (int?)ViewBag.Khoa; }
<div class="page-head"><h1>Rà soát quyền truy cập chờ khoa xác nhận</h1></div>
<div class="card"><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Đợt</th><th>Hệ thống</th><th>Tài khoản của khoa</th><th>Chưa xác nhận</th><th>Hạn</th></tr></thead><tbody>
@foreach (var d in Model) { <tr><td><a asp-action="Details" asp-route-id="@d.Id">@d.Ma</a></td><td>@d.HeThong?.Ma</td><td>@d.TaiKhoans.Count(t => t.KhoaPhongId == k)</td><td>@d.TaiKhoans.Count(t => t.KhoaPhongId == k && t.QuyetDinh == QuyetDinhTaiKhoan.ChuaXacNhan)</td><td class="small">@d.Han.ToString("dd/MM/yyyy")</td></tr> }
@if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-3">Không có đợt nào chờ khoa xác nhận.</td></tr> }
</tbody></table></div></div>
