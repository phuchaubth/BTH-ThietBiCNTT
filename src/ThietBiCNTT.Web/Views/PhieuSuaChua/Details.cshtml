@model PhieuSuaChua
@{
    ViewData["Title"] = Model.SoPhieu;
    var now = DateTime.Now;
    var cntt = User.LaCNTT();
    var tt = Model.TrangThai;
    var duocNghiemThu = Model.DuocNghiemThu(User.Identity?.Name, User.IsInRole(VaiTro.TruongKhoa), User.KhoaPhongId());
    var lichSuTb = (List<PhieuSuaChua>)ViewBag.LichSuThietBi;
    var buoc = new (string Ten, DateTime? Luc, string? Ghi)[]
    {
        ("Báo hỏng", Model.NgayYeuCau, Model.NguoiYeuCau),
        ("Tiếp nhận", Model.NgayTiepNhan, Model.KyThuatVien),
        ("Xử lý", Model.NgayBatDau, Model.DangTamDung ? tt.Ten() : null),
        ("Hoàn thành", Model.NgayHoanThanh, null),
        ("Nghiệm thu", Model.NgayNghiemThu, Model.NguoiNghiemThu),
    };
    var buocHienTai = tt switch
    {
        TrangThaiPhieuSuaChua.Moi => 1, TrangThaiPhieuSuaChua.DaTiepNhan => 2,
        TrangThaiPhieuSuaChua.DangXuLy or TrangThaiPhieuSuaChua.ChoLinhKien or TrangThaiPhieuSuaChua.GuiHang => 3,
        TrangThaiPhieuSuaChua.HoanThanh => 4, _ => 5
    };
}
<div class="small text-muted mb-1"><a asp-action="Index">Yêu cầu & công việc</a> › @Model.SoPhieu</div>
<div class="page-head">
    <h1>@Model.SoPhieu · @Model.MoTaSuCo.Split('\n')[0]</h1>
    @Html.Raw(Badge.Html(Model.UuTien)) @Html.Raw(Badge.Html(tt))
    @if (Model.LoaiCongViec == LoaiCongViec.BaoTriDinhKy) { <span class="badge bg-light text-dark border">Bảo trì định kỳ</span> }
    <div class="actions">
        <a asp-action="InPhieu" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-printer"></i> In phiếu</a>
        @if (cntt && tt == TrangThaiPhieuSuaChua.ChoLinhKien) { <a asp-controller="MuaSam" asp-action="LapDeXuat" asp-route-phieuSuaChuaId="@Model.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-cart-plus"></i> Đề xuất mua linh kiện</a> }
        @if (cntt && tt is TrangThaiPhieuSuaChua.DaTiepNhan or TrangThaiPhieuSuaChua.DangXuLy or TrangThaiPhieuSuaChua.GuiHang)
        {
            <form asp-action="TamDung" asp-route-id="@Model.Id" method="post" class="d-inline"><input type="hidden" name="lyDo" value="ChoLinhKien" /><button class="btn btn-sm btn-outline-secondary">Chờ linh kiện</button></form>
        }
        @if (cntt && tt is TrangThaiPhieuSuaChua.DaTiepNhan or TrangThaiPhieuSuaChua.DangXuLy or TrangThaiPhieuSuaChua.ChoLinhKien)
        {
            <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#guiHang">Gửi hãng / BH</button>
        }
        @if (!Model.DaDong && tt != TrangThaiPhieuSuaChua.HoanThanh && (cntt || Model.NguoiTao == User.Identity?.Name))
        {
            <button class="btn btn-sm btn-outline-danger" data-bs-toggle="collapse" data-bs-target="#huy">Huỷ phiếu</button>
        }
    </div>
</div>
<form asp-action="TamDung" asp-route-id="@Model.Id" method="post" id="guiHang" class="collapse card card-body mb-3">
    <input type="hidden" name="lyDo" value="GuiHang" />
    <div class="row g-2 align-items-end">
        <div class="col-md-4"><label class="form-label small" for="nccHang">Hãng / đơn vị bảo hành</label><select id="nccHang" name="nhaCungCapId" asp-items="ViewBag.Ncc" class="form-select form-select-sm"><option value="">—</option></select></div>
        <div class="col-md-3"><label class="form-label small" for="rma">Số phiếu hãng / RMA</label><input id="rma" name="soPhieuHang" class="form-control form-control-sm" /></div>
        <div class="col-md-3"><label class="form-label small" for="hen">Ngày hẹn trả</label><input id="hen" name="ngayHenTra" type="date" class="form-control form-control-sm" /></div>
        <div class="col-md-2"><button class="btn btn-sm btn-primary w-100">Xác nhận gửi</button></div>
    </div>
</form>
<form asp-action="Huy" asp-route-id="@Model.Id" method="post" id="huy" class="collapse card card-body mb-3">
    <div class="d-flex gap-2"><input name="lyDo" class="form-control form-control-sm" placeholder="Lý do huỷ (VD: báo nhầm, trùng phiếu)" required /><button class="btn btn-sm btn-danger">Xác nhận huỷ</button></div>
</form>

<ol class="card card-body d-flex flex-row flex-wrap gap-2 list-unstyled mb-3" aria-label="Tiến trình phiếu">
    @for (var i = 0; i < buoc.Length; i++)
    {
        var b = buoc[i];
        var mau = tt == TrangThaiPhieuSuaChua.DaHuy ? "#dfe4ea" : i + 1 < buocHienTai || (i + 1 == 5 && buocHienTai == 5) ? "#1e7a46" : i + 1 == buocHienTai ? "#1d5fbf" : "#dfe4ea";
        <li class="flex-fill" style="min-width:120px">
            <div style="height:6px;border-radius:3px;background:@mau"></div>
            <div class="small fw-semibold mt-1">@b.Ten</div>
            <div class="small text-muted">@b.Luc?.ToString("HH:mm dd/MM") @(b.Ghi is null ? "" : "· " + b.Ghi)</div>
        </li>
    }
</ol>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3"><div class="card-header">Mô tả sự cố</div><div class="card-body">
            <p class="mb-1" style="white-space:pre-line">@Model.MoTaSuCo</p>
            <div class="small text-muted">Người báo: @Model.NguoiYeuCau @(Model.DienThoaiLienHe is null ? "" : "· " + Model.DienThoaiLienHe) · @Model.NgayYeuCau.ToString("HH:mm dd/MM/yyyy")</div>
        </div></div>

        @if (cntt && tt == TrangThaiPhieuSuaChua.Moi)
        {
            <div class="card mb-3 border-primary"><div class="card-header">Tiếp nhận & phân công</div><div class="card-body">
                <form asp-action="TiepNhan" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end">
                    <div class="col-md-4"><label class="form-label small" for="ktv">Kỹ thuật viên</label><select id="ktv" name="kyThuatVien" asp-items="ViewBag.KTV" class="form-select form-select-sm" required><option value="">—</option></select></div>
                    <div class="col-md-3"><label class="form-label small" for="ht">Hình thức</label><select id="ht" name="hinhThuc" asp-items="@EnumExtensions.ToSelectList<HinhThucXuLy>()" class="form-select form-select-sm"></select></div>
                    <div class="col-md-3"><label class="form-label small" for="ncc">Đơn vị BH / thuê ngoài</label><select id="ncc" name="nhaCungCapId" asp-items="ViewBag.Ncc" class="form-select form-select-sm"><option value="">—</option></select></div>
                    <div class="col-md-2"><button class="btn btn-sm btn-primary w-100">Giao việc</button></div>
                </form>
            </div></div>
        }

        @if (cntt && tt is TrangThaiPhieuSuaChua.DaTiepNhan or TrangThaiPhieuSuaChua.ChoLinhKien or TrangThaiPhieuSuaChua.GuiHang)
        {
            <form asp-action="BatDau" asp-route-id="@Model.Id" method="post" class="mb-3"><button class="btn btn-primary"><i class="bi bi-play-fill"></i> @(Model.DangTamDung ? "Tiếp tục xử lý (chạy lại SLA)" : "Bắt đầu xử lý")</button></form>
        }

        @if (Model.KeHoachBaoTri?.MauKiemTraId is { } mauCk)
        {
            var lanCk = ViewBag.ChecklistBaoTri as LanKiemTra;
            <div class="card mb-3 @(lanCk is null ? "border-warning" : "")"><div class="card-body d-flex flex-wrap gap-2 align-items-center">
                <i class="bi bi-ui-checks fs-4"></i>
                @if (lanCk is null)
                {
                    <div class="flex-grow-1"><b>Checklist bảo trì chưa thực hiện</b><div class="small text-muted">Bắt buộc trước khi hoàn thành lệnh. Mục "Không đạt" sẽ tự tạo phiếu sửa chữa.</div></div>
                    @if (cntt && !Model.DaDong && tt != TrangThaiPhieuSuaChua.HoanThanh) { <a class="btn btn-primary" href="/KiemTra/Ghi?mauId=@mauCk&taiSanId=@Model.TaiSanId&phieuBaoTriId=@Model.Id"><i class="bi bi-clipboard-check"></i> Thực hiện checklist</a> }
                }
                else
                {
                    <div class="flex-grow-1"><b>Đã thực hiện checklist</b> · @lanCk.ThoiGian.ToString("dd/MM HH:mm") · @lanCk.NguoiKiem
                        @if (lanCk.CoBatThuong) { <span class="badge bg-danger">Có mục không đạt</span> } else { <span class="badge bg-success">Đạt</span> }</div>
                    <a class="btn btn-sm btn-outline-secondary" href="/KiemTra/Lan/@lanCk.Id">Xem kết quả</a>
                }
            </div></div>
        }
        @if (cntt && tt is TrangThaiPhieuSuaChua.DaTiepNhan or TrangThaiPhieuSuaChua.DangXuLy or TrangThaiPhieuSuaChua.ChoLinhKien or TrangThaiPhieuSuaChua.GuiHang)
        {
            <div class="card mb-3"><div class="card-header">Ghi nhận kết quả xử lý</div><div class="card-body">
                <form asp-action="HoanThanh" asp-route-id="@Model.Id" method="post" class="row g-2">
                    @{ var batBuocNn = Model.LoaiCongViec == LoaiCongViec.SuaChua && ThamSo.BatTat(TS.BatBuocNguyenNhan); }
                    <div class="col-md-6"><label class="form-label small" for="nnn">Nhóm nguyên nhân @if (batBuocNn) { <span class="text-danger">*</span> }</label>
                        <select id="nnn" name="nhomNguyenNhan" asp-items="@EnumExtensions.ToSelectList(Model.NhomNguyenNhan)" class="form-select form-select-sm" required="@batBuocNn"><option value="">—</option></select></div>
                    <div class="col-md-6"><label class="form-label small" for="hdk">Hành động khắc phục</label>
                        <select id="hdk" name="hanhDongKhacPhuc" asp-items="@EnumExtensions.ToSelectList(Model.HanhDongKhacPhuc)" class="form-select form-select-sm"><option value="">—</option></select></div>
                    <div class="col-md-6"><label class="form-label small" for="nn">Nguyên nhân chi tiết</label><input id="nn" name="nguyenNhan" value="@Model.NguyenNhan" class="form-control form-control-sm" /></div>
                    <div class="col-md-3"><label class="form-label small" for="gc">Giờ công</label>
                        @if (Model.GioCongs.Count > 0) { <input id="gc" value="@Model.GioCong.ToString("0.##")" class="form-control form-control-sm" readonly title="Tính từ nhật ký giờ công" /><input type="hidden" name="gioCong" value="0" /> }
                        else { <input id="gc" name="gioCong" type="number" step="0.25" min="0" value="@Model.GioCong.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm" /> }</div>
                    <div class="col-md-3"><label class="form-label small" for="cp">Chi phí thuê ngoài (đ)</label><input id="cp" name="chiPhiThueNgoai" type="number" step="1000" min="0" value="@Model.ChiPhiThueNgoai.ToString("0")" class="form-control form-control-sm" /></div>
                    @if (Model.LoaiCongViec == LoaiCongViec.BaoTriDinhKy || Model.TaiSan?.ChiSoBoDem is not null)
                    {
                        <div class="col-md-4"><label class="form-label small" for="csbd">Chỉ số bộ đếm hiện tại @(Model.KeHoachBaoTri?.DonViChiSo is { } dv ? $"({dv})" : "")</label>
                            <input id="csbd" name="chiSoBoDem" type="number" min="0" class="form-control form-control-sm" placeholder="@Model.TaiSan?.ChiSoBoDem?.ToString("N0")" /></div>
                    }
                    <div class="col-12"><label class="form-label small" for="bp">Biện pháp khắc phục <span class="text-danger">*</span></label><textarea id="bp" name="bienPhap" rows="2" class="form-control form-control-sm" required>@Model.BienPhapKhacPhuc</textarea></div>
                    <div class="col-12"><button class="btn btn-success"><i class="bi bi-check2-circle"></i> Hoàn thành · gửi khoa nghiệm thu</button></div>
                </form>
            </div></div>
        }
        else if (Model.BienPhapKhacPhuc is not null)
        {
            <div class="card mb-3"><div class="card-header">Kết quả xử lý</div><div class="card-body">
                <dl class="row info mb-0">
                    <div class="col-md-6"><dt>Nguyên nhân</dt><dd>@Model.NhomNguyenNhan?.Ten() @(Model.NhomNguyenNhan is null || Model.NguyenNhan is null ? "" : "·") @Model.NguyenNhan</dd></div>
                    <div class="col-md-3"><dt>Hình thức</dt><dd>@Model.HinhThucXuLy?.Ten() @Model.NhaCungCap?.Ten</dd></div>
                    <div class="col-md-3"><dt>Giờ công</dt><dd>@Model.GioCong.ToString("0.##") @(Model.ChiPhiNhanCong > 0 ? $"({Model.ChiPhiNhanCong:N0} đ)" : "")</dd></div>
                    @if (Model.HanhDongKhacPhuc is not null) { <div class="col-md-6"><dt>Hành động khắc phục</dt><dd>@Model.HanhDongKhacPhuc.Value.Ten()</dd></div> }
                    <div class="col-12"><dt>Biện pháp khắc phục</dt><dd>@Model.BienPhapKhacPhuc</dd></div>
                    @if (Model.NgayNghiemThu is not null) { <div class="col-md-6"><dt>Nghiệm thu</dt><dd>@Model.NguoiNghiemThu · @Model.NgayNghiemThu?.ToString("HH:mm dd/MM") @(Model.DanhGia is { } d ? $"· {d}/5 sao" : "")</dd></div> }
                    @if (Model.YKienNguoiDung is not null) { <div class="col-md-6"><dt>Ý kiến khoa</dt><dd>@Model.YKienNguoiDung</dd></div> }
                </dl>
            </div></div>
        }

        @if (tt == TrangThaiPhieuSuaChua.HoanThanh)
        {
            <div class="card mb-3 @(duocNghiemThu ? "border-success" : "")"><div class="card-header">Nghiệm thu</div><div class="card-body">
                @if (duocNghiemThu)
                {
                    <form asp-action="NghiemThu" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end mb-2">
                        <div class="col-md-3"><label class="form-label small" for="dg">Đánh giá</label><select id="dg" name="danhGia" class="form-select form-select-sm"><option value="5">5 – Rất hài lòng</option><option value="4">4 – Hài lòng</option><option value="3">3 – Bình thường</option><option value="2">2 – Chưa hài lòng</option><option value="1">1 – Không hài lòng</option></select></div>
                        <div class="col-md-6"><label class="form-label small" for="yk">Ý kiến</label><input id="yk" name="yKien" class="form-control form-control-sm" /></div>
                        <div class="col-md-3"><button class="btn btn-sm btn-success w-100">Đồng ý nghiệm thu</button></div>
                    </form>
                    <form asp-action="TraLai" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                        <input name="yKien" class="form-control form-control-sm" placeholder="Chưa đạt? Ghi lý do để KTV xử lý lại" required />
                        <button class="btn btn-sm btn-outline-danger text-nowrap">Trả lại KTV</button>
                    </form>
                }
                else
                {
                    <div class="small text-muted">Chờ người báo hỏng (@Model.NguoiTao) hoặc Trưởng khoa/phòng @Model.KhoaPhong?.Ten nghiệm thu. Phiếu sẽ tự nghiệm thu sau @ThamSo.SoNguyen(TS.NghiemThuTuDongSauNgay) ngày nếu không phản hồi.</div>
                }
            </div></div>
        }

        @await Html.PartialAsync("_DinhKem", (DoiTuong: "PhieuSuaChua", DoiTuongId: Model.Id.ToString(), Teps: (List<TepDinhKem>)ViewBag.Tep, DuocTaiLen: !Model.DaDong))

        @if (cntt && Model.TrangThai != TrangThaiPhieuSuaChua.Moi && (Model.GioCongs.Count > 0 || !Model.DaDong))
        {
            var sua = !Model.DaDong && tt != TrangThaiPhieuSuaChua.HoanThanh;
            <div class="card mb-3" id="gio-cong"><div class="card-header d-flex">Giờ công theo kỹ thuật viên <span class="ms-auto fw-normal small">Tổng <b>@Model.GioCong.ToString("0.##")</b> giờ @if ((int)ViewBag.DonGiaGio > 0) { <span>· @(((int)ViewBag.DonGiaGio).ToString("N0")) đ/giờ</span> }</span></div>
                <table class="table table-sm mb-0">
                    <thead><tr><th>Người</th><th>Bắt đầu</th><th>Kết thúc</th><th class="text-end">Giờ</th><th>Ghi chú</th>@if (sua) { <th></th> }</tr></thead>
                    <tbody>@foreach (var g in Model.GioCongs) {
                        <tr><td>@g.NguoiThucHien</td><td class="small">@g.BatDau.ToString("HH:mm dd/MM")</td><td class="small">@g.KetThuc.ToString("HH:mm dd/MM")</td><td class="text-end">@g.SoGio.ToString("0.##")</td><td class="small">@g.GhiChu</td>
                            @if (sua) { <td><form asp-action="XoaGioCong" asp-route-id="@Model.Id" method="post"><input type="hidden" name="gioCongId" value="@g.Id" /><button class="btn btn-link btn-sm p-0 text-danger">Xoá</button></form></td> }</tr> }
                    @if (Model.GioCongs.Count == 0) { <tr><td colspan="6" class="small text-muted">Chưa ghi. Mỗi KTV ghi thời gian làm thực tế; khi có nhật ký, giờ công phiếu = tổng các dòng.</td></tr> }</tbody>
                </table>
                @if (sua)
                {
                    <form asp-action="GhiGioCong" asp-route-id="@Model.Id" method="post" class="d-flex flex-wrap gap-2 p-3 border-top">
                        <select name="nguoi" asp-items="ViewBag.KTV" class="form-select form-select-sm" style="width:200px" aria-label="Người thực hiện"><option value="">(tôi)</option></select>
                        <input type="datetime-local" name="batDau" value="@now.AddHours(-1).ToString("yyyy-MM-ddTHH:mm")" class="form-control form-control-sm" style="width:190px" aria-label="Bắt đầu" required />
                        <input type="datetime-local" name="ketThuc" value="@now.ToString("yyyy-MM-ddTHH:mm")" class="form-control form-control-sm" style="width:190px" aria-label="Kết thúc" required />
                        <input name="ghiChu" class="form-control form-control-sm" style="flex:1 1 140px" placeholder="Ghi chú" aria-label="Ghi chú" />
                        <button class="btn btn-sm btn-outline-primary">Ghi giờ công</button>
                    </form>
                }
            </div>
        }

        <div class="card mb-3"><div class="card-header d-flex">Vật tư sử dụng <span class="ms-auto fw-normal small">Tổng chi phí: <b>@Model.TongChiPhi.ToString("N0") đ</b>
            <span class="text-muted">(vật tư @Model.ChiPhiVatTu.ToString("N0") · thuê ngoài @Model.ChiPhiThueNgoai.ToString("N0")@(Model.ChiPhiNhanCong > 0 ? " · nhân công " + Model.ChiPhiNhanCong.ToString("N0") : ""))</span></span></div>
            @if (cntt && !Model.DaDong && tt != TrangThaiPhieuSuaChua.HoanThanh)
            {
                <form asp-action="ThemVatTu" asp-route-id="@Model.Id" method="post" class="d-flex flex-wrap gap-2 p-3 border-bottom">
                    <select name="vatTu" asp-items="ViewBag.VatTu" class="form-select form-select-sm" style="flex:1 1 260px" aria-label="Chọn vật tư"></select>
                    <input name="soLuong" type="number" min="1" step="1" value="1" class="form-control form-control-sm" style="width:80px" aria-label="Số lượng" />
                    <button class="btn btn-sm btn-outline-primary">Xuất kho</button>
                </form>
            }
            <table class="table table-sm mb-0">
                <thead><tr><th>Vật tư</th><th class="text-end">SL</th><th class="text-end">Đơn giá</th><th class="text-end">Thành tiền</th></tr></thead>
                <tbody>
                @foreach (var v in Model.VatTus) { <tr><td>@v.VatTu?.Ma · @v.VatTu?.Ten</td><td class="text-end">@v.SoLuong.ToString("0.##")</td><td class="text-end">@v.DonGia.ToString("N0")</td><td class="text-end">@v.ThanhTien.ToString("N0")</td></tr> }
                @if (Model.VatTus.Count == 0) { <tr><td colspan="4" class="text-muted small">Chưa dùng vật tư. Khi xuất, tồn kho tự trừ và chi phí cộng vào tài sản.</td></tr> }
                </tbody>
            </table>
        </div>

        <div class="card" id="trao-doi"><div class="card-header">Trao đổi</div><div class="card-body">
            @foreach (var b in Model.BinhLuans)
            {
                if (b.LaHeThong) { <div class="comment sys">@b.ThoiGian.ToString("HH:mm dd/MM") · @b.NguoiViet · @b.NoiDung</div> }
                else
                {
                    var nd = System.Text.RegularExpressions.Regex.Replace(System.Net.WebUtility.HtmlEncode(b.NoiDung), @"(?<![\w.@])@([A-Za-z0-9][A-Za-z0-9._-]{1,99})", "<span class=\"text-primary fw-semibold\">@$1</span>");
                    <div class="comment @(b.NoiBo ? "border-start border-warning border-3 ps-2" : "")"><b>@b.NguoiViet</b> <span class="small text-muted">@b.ThoiGian.ToString("HH:mm dd/MM")</span>
                        @if (b.NoiBo) { <span class="badge bg-warning-subtle text-warning-emphasis border">Nội bộ CNTT</span> }
                        <div style="white-space:pre-line">@Html.Raw(nd)</div></div>
                }
            }
            @if (!Model.DaDong)
            {
                <form asp-action="BinhLuan" asp-route-id="@Model.Id" method="post" class="mt-2">
                    <div class="d-flex gap-2">
                        <textarea name="noiDung" rows="1" class="form-control" placeholder="Viết trao đổi… gõ @@tên_đăng_nhập để nhắc người liên quan" aria-label="Viết trao đổi" required></textarea>
                        <button class="btn btn-primary">Gửi</button>
                    </div>
                    @if (cntt) { <div class="form-check mt-1"><input class="form-check-input" type="checkbox" name="noiBo" value="true" id="noiBo" /><label class="form-check-label small" for="noiBo">Nội bộ CNTT (người báo, khoa không thấy)</label></div> }
                </form>
            }
        </div></div>
    </div>

    <div class="col-lg-4">
        @{
            var quaHan = Model.QuaHan(now);
            var hopMau = Model.DangTamDung ? "secondary" : quaHan ? "danger" : "primary";
        }
        @if (!Model.DaDong)
        {
            <div class="card mb-3 border-@hopMau"><div class="card-body">
                <div class="small text-uppercase fw-semibold text-@hopMau">Hạn xử lý SLA</div>
                <div class="fs-4 fw-bold"><partial name="_SlaText" model="Model" /></div>
                <div class="small text-muted">Hạn @Model.HanXuLy.ToString("HH:mm dd/MM/yyyy") · @Model.UuTien.Ten()@(Model.KhoaPhong?.LaKhoaTrongYeu == true ? " · khoa trọng yếu" : "")</div>
                @if (Model.NgayGuiHang is not null) { <div class="small mt-1">Gửi hãng @Model.NgayGuiHang?.ToString("dd/MM") @(Model.SoPhieuHang is null ? "" : "· RMA " + Model.SoPhieuHang) @(Model.NgayHenTra is null ? "" : "· hẹn trả " + Model.NgayHenTra?.ToString("dd/MM")) @(Model.NgayNhanVe is null ? "" : "· nhận về " + Model.NgayNhanVe?.ToString("dd/MM"))</div> }
                @if (Model.DangTamDung) { <div class="small mt-1">Tạm dừng từ @Model.BatDauTamDung?.ToString("HH:mm dd/MM"). Hạn sẽ được dời khi tiếp tục xử lý.</div> }
                @if (Model.TongTamDungGiay > 0) { <div class="small text-muted">Đã tạm dừng tổng @((Model.TongTamDungGiay / 3600.0).ToString("0.#")) giờ.</div> }
            </div></div>
        }
        @if (Model.ThietBiTam is { } tam)
        {
            <div class="card mb-3 @(Model.DangChoMuonTam ? "border-warning" : "")"><div class="card-header">Thiết bị cho mượn tạm</div><div class="card-body small">
                <a asp-controller="TaiSan" asp-action="Details" asp-route-id="@tam.Id" class="fw-semibold">@tam.MaTaiSan · @tam.Ten</a>
                <div>Cho mượn @Model.NgayChoMuonTam?.ToString("HH:mm dd/MM/yyyy")@(Model.NgayThuHoiTam is { } th ? " · đã thu hồi " + th.ToString("HH:mm dd/MM") : "")</div>
                @if (Model.DangChoMuonTam && tt is TrangThaiPhieuSuaChua.HoanThanh or TrangThaiPhieuSuaChua.DaNghiemThu) { <div class="text-danger mt-1"><i class="bi bi-exclamation-triangle"></i> Máy đã sửa xong — thu hồi thiết bị mượn.</div> }
                @if (Model.DangChoMuonTam && cntt) { <form asp-action="ThuHoiTam" asp-route-id="@Model.Id" method="post" class="mt-2"><button class="btn btn-sm btn-outline-warning">Thu hồi về kho</button></form> }
            </div></div>
        }
        else if (ViewBag.ThietBiDuPhong is SelectList dp && dp.Any())
        {
            <div class="card mb-3"><div class="card-header">Cho mượn thiết bị thay thế tạm</div><div class="card-body">
                <form asp-action="ChoMuonTam" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                    <select name="thietBiTamId" asp-items="dp" class="form-select form-select-sm" aria-label="Thiết bị dự phòng trong kho"></select>
                    <button class="btn btn-sm btn-outline-primary text-nowrap">Cho mượn</button>
                </form>
                <div class="form-text">Thiết bị trong kho, cùng loại xếp trước. Hệ thống nhắc thu hồi khi phiếu hoàn thành.</div>
            </div></div>
        }
        <div class="card mb-3"><div class="card-header">Thiết bị</div><div class="card-body small">
            <a asp-controller="TaiSan" asp-action="Details" asp-route-id="@Model.TaiSanId" class="fw-semibold">@Model.TaiSan?.MaTaiSan · @Model.TaiSan?.Ten</a>
            <div class="mt-1">@Model.TaiSan?.LoaiThietBi?.Ten · @Model.KhoaPhong?.Ten</div>
            @if (Model.TaiSan?.CauHinh is { } ch) { <div class="font-monospace">@ch.DiaChiIP · @ch.Hostname</div> }
            @if (Model.TaiSan?.HanBaoHanh is { } bh) { <div>Bảo hành đến @bh.ToString("dd/MM/yyyy") @(bh >= DateOnly.FromDateTime(now) ? "(còn BH)" : "(hết BH)")</div> }
        </div></div>
        @if (lichSuTb.Count > 0)
        {
            <div class="card"><div class="card-header">Lần sửa trước của máy này</div><div class="list-group list-group-flush">
                @foreach (var l in lichSuTb) { <a class="list-group-item list-group-item-action small" asp-action="Details" asp-route-id="@l.Id"><b>@l.SoPhieu</b> · @l.NgayYeuCau.ToString("dd/MM/yy") · @l.MoTaSuCo.Split('\n')[0]</a> }
            </div></div>
        }
    </div>
</div>
