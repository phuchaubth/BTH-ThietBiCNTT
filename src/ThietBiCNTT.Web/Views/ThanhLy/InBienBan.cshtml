@model DeXuatThanhLy
@{ Layout = "_Print"; ViewData["Title"] = "Biên bản kiểm định " + Model.SoPhieu; var i = 1; }
<partial name="_HeaderBenhVien" />
<h3>BIÊN BẢN KIỂM ĐỊNH TÌNH TRẠNG TÀI SẢN ĐỀ NGHỊ THANH LÝ</h3>
<p class="text-center">Số: <b>@Model.SoPhieu</b></p>
<p><b>Thành phần hội đồng:</b> @(Model.HoiDong ?? "........................................................................")</p>
<p><b>Lý do đề nghị thanh lý:</b> @Model.LyDo</p>
<table class="bb w-100 mb-3">
    <tr><th>STT</th><th>Mã TS</th><th>Tên tài sản</th><th>Năm SD</th><th>Nguyên giá</th><th>Giá trị còn lại</th><th>Tình trạng kỹ thuật</th><th>Serial ổ cứng đã tháo</th></tr>
    @foreach (var c in Model.ChiTiets) { <tr><td>@(i++)</td><td>@c.TaiSan?.MaTaiSan</td><td>@c.TaiSan?.Ten</td><td>@((c.TaiSan?.NgaySuDung ?? c.TaiSan?.NgayMua)?.Year)</td><td class="text-end">@c.TaiSan?.NguyenGia.ToString("N0")</td><td class="text-end">@c.GiaTriConLai.ToString("N0")</td><td>@c.TinhTrang</td><td>@c.SerialOCung</td></tr> }
</table>
<p><b>Kết luận của hội đồng:</b> @(Model.KetLuanHoiDong ?? "")</p>
@if (Model.SoQuyetDinh is not null) { <p><b>Quyết định thanh lý:</b> số @Model.SoQuyetDinh ngày @Model.NgayQuyetDinh?.ToString("dd/MM/yyyy"), hình thức: @Model.HinhThuc?.Ten()</p> }
<div class="ky"><div><b>Thư ký hội đồng</b><br /><i>(Ký, ghi rõ họ tên)</i></div><div><b>Chủ tịch hội đồng</b><br /><i>(Ký, ghi rõ họ tên)</i></div></div>
