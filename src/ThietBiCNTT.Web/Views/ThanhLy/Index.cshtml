@model List<DeXuatThanhLy>
@{ ViewData["Title"] = "Thanh lý"; }
<div class="page-head">
    <h1>Thanh lý tài sản</h1>
    <div class="actions">
        @if (User.LaCNTT())
        {
            <a asp-action="OCung" class="btn btn-sm btn-outline-secondary"><i class="bi bi-device-hdd"></i> Ổ cứng thu hồi</a>
            <a asp-action="Create" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> Lập đề xuất</a>
        }
    </div>
</div>
<form method="get" class="mb-3 d-flex gap-2" style="max-width:380px">
    <select name="trangThai" class="form-select form-select-sm" asp-items="@EnumExtensions.ToSelectList((TrangThaiThanhLy?)ViewData["trangThai"])" aria-label="Trạng thái"><option value="">— Tất cả trạng thái —</option></select>
    <button class="btn btn-sm btn-outline-secondary">Lọc</button>
</form>
<div class="card"><div class="table-responsive">
<table class="table table-hover mb-0 align-middle">
    <thead><tr><th>Số đề xuất</th><th>Lý do</th><th>Số TS</th><th class="text-end">Nguyên giá</th><th>Quyết định</th><th>Trạng thái</th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr><td class="fw-semibold"><a asp-action="Details" asp-route-id="@p.Id">@p.SoPhieu</a><div class="small text-muted fw-normal">@p.NgayTao.ToString("dd/MM/yyyy")</div></td>
            <td class="small">@p.LyDo</td><td>@p.ChiTiets.Count</td><td class="text-end small">@p.ChiTiets.Sum(c => c.TaiSan?.NguyenGia ?? 0).ToString("N0")</td>
            <td class="small">@p.SoQuyetDinh</td><td>@Html.Raw(Badge.Html(p.TrangThai))</td></tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có đề xuất thanh lý.</td></tr> }
    </tbody>
</table>
</div></div>
