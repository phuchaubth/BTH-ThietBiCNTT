@model DeXuatThanhLy
@{
    ViewData["Title"] = "Lập đề xuất thanh lý";
    var ds = (List<TaiSan>)ViewBag.TaiSan;
    var homNay = DateOnly.FromDateTime(DateTime.Today);
}
<div class="page-head"><h1>Lập đề xuất thanh lý</h1></div>
<form asp-action="Create" method="post">
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card"><div class="card-header">Chọn tài sản <span class="small fw-normal text-muted">— ưu tiên hiển thị thiết bị hỏng và quá tuổi thọ</span></div>
                <div class="table-responsive" style="max-height:560px">
                <table class="table table-sm table-hover mb-0 align-middle">
                    <thead><tr><th></th><th>Mã TS</th><th>Tên · khoa</th><th>Tuổi</th><th>Trạng thái</th><th class="text-end">Nguyên giá</th></tr></thead>
                    <tbody>
                    @foreach (var t in ds)
                    {
                        var tuoi = t.TuoiNam(homNay);
                        var qua = tuoi >= (t.LoaiThietBi?.TuoiThoNam ?? 5);
                        <tr><td><input type="checkbox" class="form-check-input" name="taiSanIds" value="@t.Id" id="t@(t.Id)" /></td>
                            <td><label for="t@(t.Id)" class="fw-semibold">@t.MaTaiSan</label></td><td class="small">@t.Ten<div class="text-muted">@t.KhoaPhong?.Ten</div></td>
                            <td class="small @(qua ? "text-danger fw-semibold" : "")">@tuoi năm</td><td>@Html.Raw(Badge.Html(t.TrangThai))</td><td class="text-end small">@t.NguyenGia.ToString("N0")</td></tr>
                    }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card"><div class="card-body">
                <label asp-for="LyDo" class="form-label"></label>
                <textarea asp-for="LyDo" class="form-control mb-3" rows="4" required placeholder="VD: Hư hỏng không kinh tế để sửa, quá thời gian sử dụng"></textarea>
                <button class="btn btn-primary w-100">Lập đề xuất</button>
                <div class="small text-muted mt-2">Sau khi lập: nhập tình trạng, giá trị còn lại → gửi hội đồng → quyết định → tháo ổ cứng → hoàn tất ghi giảm.</div>
            </div></div>
        </div>
    </div>
</form>
