@model PhieuDieuChuyen
@{
    ViewData["Title"] = "Lập phiếu điều chuyển";
    var dsTs = (List<TaiSan>)ViewBag.DsTaiSan;
    var chon = (int[])ViewData["chon"]!;
    var nguong = (long)ViewBag.Nguong;
}
<div class="page-head"><h1>Lập phiếu điều chuyển</h1></div>
<form method="get" asp-action="Create" class="card card-body mb-3" style="max-width:820px">
    <div class="row g-2 align-items-end">
        <div class="col-md-8"><label class="form-label" for="tk">Khoa/phòng đi</label>
            <select id="tk" name="tuKhoa" class="form-select" asp-items="@(new SelectList((SelectList)ViewBag.DsKhoa, "Value", "Text", Model.TuKhoaPhongId))" disabled="@(!User.XemToanVien())" onchange="this.form.submit()"><option value="">— Chọn khoa đi —</option></select></div>
        <div class="col-md-4 small text-muted">Chọn khoa đi để hiện danh sách tài sản.</div>
    </div>
</form>
@if (Model.TuKhoaPhongId is not null)
{
<form asp-action="Create" method="post">
    <input type="hidden" asp-for="TuKhoaPhongId" />
    <div asp-validation-summary="All" class="alert alert-danger small" ></div>
    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card"><div class="card-header d-flex">Chọn tài sản <span class="ms-auto small fw-normal">Tổng nguyên giá: <b id="tong">0</b> đ</span></div>
                <div class="table-responsive" style="max-height:480px">
                <table class="table table-sm table-hover mb-0">
                    <thead><tr><th></th><th>Mã TS</th><th>Tên</th><th>Người SD</th><th class="text-end">Nguyên giá</th></tr></thead>
                    <tbody>
                    @foreach (var t in dsTs)
                    {
                        <tr><td><input type="checkbox" class="form-check-input chon" name="taiSanIds" value="@t.Id" data-gia="@t.NguyenGia.ToString("0")" id="ts@(t.Id)" @(chon.Contains(t.Id) ? "checked" : "") /></td>
                            <td><label for="ts@(t.Id)" class="fw-semibold">@t.MaTaiSan</label></td><td class="small">@t.Ten<div class="text-muted">@t.LoaiThietBi?.Ten</div></td><td class="small">@t.NguoiSuDung</td><td class="text-end small">@t.NguyenGia.ToString("N0")</td></tr>
                    }
                    @if (dsTs.Count == 0) { <tr><td colspan="5" class="text-muted text-center py-3">Khoa này không có tài sản có thể điều chuyển.</td></tr> }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card"><div class="card-body">
                @if (User.LaCNTT())
                {
                    <div class="form-check mb-2"><input asp-for="RaNgoai" class="form-check-input" id="raNgoai" /><label asp-for="RaNgoai" class="form-check-label" for="raNgoai"></label></div>
                    <div class="mb-3 o-ngoai"><label asp-for="DonViNhanNgoai" class="form-label"></label><input asp-for="DonViNhanNgoai" class="form-control" placeholder="VD: Trung tâm Y tế huyện …" />
                        <div class="form-text">Luôn qua Lãnh đạo duyệt. Khi bàn giao phải có số/ngày quyết định; tài sản được ghi giảm và đưa vào Số liệu kế toán gửi TCKT.</div></div>
                }
                <div class="mb-3 o-trong"><label asp-for="DenKhoaPhongId" class="form-label"></label><select asp-for="DenKhoaPhongId" asp-items="ViewBag.DsKhoa" class="form-select" id="denKhoa"><option value="">—</option></select></div>
                <div class="mb-3 o-trong"><label asp-for="DenViTriId" class="form-label"></label><select asp-for="DenViTriId" asp-items="ViewBag.DsViTri" class="form-select"><option value="">—</option></select></div>
                <div class="mb-3"><label asp-for="NguoiNhan" class="form-label"></label><input asp-for="NguoiNhan" class="form-control" /></div>
                <div class="mb-3"><label asp-for="LyDo" class="form-label"></label><textarea asp-for="LyDo" class="form-control" rows="3" required></textarea></div>
                <div class="alert alert-info small py-2" id="capDuyet">Duyệt: Trưởng khoa đi → Phòng CNTT.</div>
                <button name="guiDuyet" value="true" class="btn btn-primary">Lưu & gửi duyệt</button>
                <button name="guiDuyet" value="false" class="btn btn-outline-secondary">Lưu nháp</button>
            </div></div>
        </div>
    </div>
</form>
@section Scripts {
<script>
(function () {
    var nguong = @nguong;
    function cap() {
        var ngoai = document.getElementById('raNgoai')?.checked;
        document.querySelectorAll('.o-ngoai').forEach(e => e.classList.toggle('d-none', !ngoai));
        document.querySelectorAll('.o-trong').forEach(e => e.classList.toggle('d-none', !!ngoai));
        var tong = 0;
        document.querySelectorAll('.chon:checked').forEach(function (c) { tong += +c.dataset.gia; });
        document.getElementById('tong').textContent = tong.toLocaleString('vi-VN');
        document.getElementById('capDuyet').textContent = tong >= nguong
            ? 'Tổng ≥ ' + nguong.toLocaleString('vi-VN') + ' đ → duyệt 3 cấp: Trưởng khoa đi → Phòng CNTT → Lãnh đạo.'
            : 'Tổng < ' + nguong.toLocaleString('vi-VN') + ' đ → duyệt 2 cấp: Trưởng khoa đi → Phòng CNTT.';
        if (ngoai) document.getElementById('capDuyet').textContent = 'Chuyển ra ngoài bệnh viện → luôn duyệt đến Lãnh đạo (Trưởng khoa đi → Phòng CNTT → Lãnh đạo).';
    }
    document.querySelectorAll('.chon').forEach(function (c) { c.addEventListener('change', cap); });
    document.getElementById('raNgoai')?.addEventListener('change', cap);
    cap();
})();
</script>
}
}
