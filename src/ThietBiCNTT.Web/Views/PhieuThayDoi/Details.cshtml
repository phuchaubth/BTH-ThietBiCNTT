@model PhieuThayDoi
@{
    ViewData["Title"] = Model.Ma; var cntt = User.LaCNTT(); var tq = (bool)ViewBag.ToiQuanTrong; var buocTiep = (BuocDuyetThayDoi?)ViewBag.BuocTiep; var thieu = (List<string>)ViewBag.Thieu; var trung = (List<PhieuThayDoi>)ViewBag.Trung; var hds = (List<HanhDongKhacPhuc>)ViewBag.HanhDong;
    bool qCntt = ViewBag.QuyenCntt, qLd = ViewBag.QuyenLanhDao, qCsh = ViewBag.QuyenChuSoHuu; var now = DateTime.Now;
    bool DuocDuyet(BuocDuyetThayDoi b) => b switch { BuocDuyetThayDoi.Cntt => qCntt, BuocDuyetThayDoi.LanhDao => qLd, _ => qCsh };
}
<div class="small text-muted mb-1"><a asp-action="Index">Quản lý thay đổi</a> › @Model.Ma</div>
<div class="page-head"><h1>@Model.Ma · @Model.Ten</h1> @Html.Raw(Badge.Html(Model.TrangThai)) @Html.Raw(Badge.Html(Model.Loai))
    @if (cntt && Model.TrangThai == TrangThaiThayDoi.Nhap) { <div class="actions"><a asp-action="Form" asp-route-id="@Model.Id" class="btn btn-sm btn-primary"><i class="bi bi-pencil"></i> Sửa</a></div> }</div>
@if (Model.QuaHanDuyetBoSung(now)) { <div class="alert alert-danger py-2"><i class="bi bi-exclamation-octagon"></i> Thay đổi khẩn cấp chưa được duyệt bổ sung, quá hạn @Model.HanDuyetBoSung?.ToString("dd/MM/yyyy").</div> }
@if (trung.Count > 0) { <div class="alert alert-warning py-2"><i class="bi bi-exclamation-triangle"></i> Trùng khung giờ với: @foreach (var t in trung) { <a asp-action="Details" asp-route-id="@t.Id">@t.Ma</a> <span>(@t.Ten)</span> }</div> }
@if (Model.TrangThai is TrangThaiThayDoi.Nhap or TrangThaiThayDoi.ChoDuyet && thieu.Count > 0) { <div class="alert alert-warning py-2"><b>Còn thiếu:</b> @string.Join("; ", thieu).</div> }
@if (Model.NenTaoHanhDong) { <div class="alert alert-info py-2">Kết quả @Model.TrangThai.Ten().ToLower()@(Model.CoVanDe ? " (có vấn đề)" : ""): nên tạo hành động khắc phục.</div> }
<div class="row g-3"><div class="col-lg-8">
    <div class="card mb-3"><div class="card-body"><dl class="row info mb-0">
        <div class="col-12"><dt>Mô tả</dt><dd style="white-space:pre-line">@Model.MoTa</dd></div>
        <div class="col-12"><dt>Lý do</dt><dd style="white-space:pre-line">@Model.LyDo</dd></div>
        <div class="col-sm-6"><dt>Hệ thống bị tác động</dt><dd>@foreach (var h in Model.HeThongs) { <a asp-controller="HeThong" asp-action="Details" asp-route-id="@h.HeThongId" class="badge bg-light text-dark border text-decoration-none">@h.HeThong?.Ma</a> } @if (tq) { <span class="badge bg-danger">Tối quan trọng</span> }</dd></div>
        <div class="col-sm-3"><dt>Mức rủi ro</dt><dd>@Model.MucRui.Ten()</dd></div><div class="col-sm-3"><dt>Thay đổi lớn</dt><dd>@(Model.LaThayDoiLon ? "Có" : "Không")</dd></div>
        <div class="col-sm-6"><dt>Kế hoạch thực hiện</dt><dd style="white-space:pre-line">@Model.KeHoachThucHien</dd></div><div class="col-sm-6"><dt>Kế hoạch kiểm thử</dt><dd style="white-space:pre-line">@Model.KeHoachKiemThu</dd></div>
        <div class="col-12"><dt>Phương án quay lui</dt><dd style="white-space:pre-line">@Model.PhuongAnQuayLui</dd></div>
        <div class="col-sm-6"><dt>Khung giờ đề xuất</dt><dd>@Model.DeXuatBatDau?.ToString("dd/MM/yyyy HH:mm") – @Model.DeXuatKetThuc?.ToString("dd/MM/yyyy HH:mm")</dd></div>
        <div class="col-sm-3"><dt>Người đề xuất</dt><dd>@Model.NguoiDeXuat</dd></div><div class="col-sm-3"><dt>Phiên bản mới</dt><dd>@Model.PhienBanMoi</dd></div>
        @if (Model.TaiSan is not null) { <div class="col-sm-6"><dt>Tài sản</dt><dd><a asp-controller="TaiSan" asp-action="Details" asp-route-id="@Model.TaiSanId">@Model.TaiSan.MaTaiSan</a></dd></div> }
        @if (Model.CanDowntime) { <div class="col-sm-6"><dt>Downtime</dt><dd>@if (Model.SuKienDowntime is not null) { <a asp-controller="SuKienDowntime" asp-action="Details" asp-route-id="@Model.SuKienDowntimeId">@Model.SuKienDowntime.Ma</a> } else if (cntt && Model.TrangThai is TrangThaiThayDoi.DaDuyet or TrangThaiThayDoi.DangThucHien) { <form asp-action="TaoDowntime" asp-route-id="@Model.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger">Tạo downtime có kế hoạch và thông báo khoa</button></form> } else { <span class="text-muted">Chưa tạo</span> }</dd></div> }
        @if (Model.LaHeThongSaoLuu) { <div class="col-sm-6"><dt>Hệ thống sao lưu</dt><dd class="small">Hoàn thành sẽ tự tạo lần thử phục hồi ngoài lịch (FR-SL-09).</dd></div> }
    </dl></div></div>

    <div class="card mb-3"><div class="card-header">Phê duyệt <span class="small fw-normal text-muted">FR-TD-02</span></div><div class="card-body">
        @{ var cac = Model.BuocCanDuyet(tq); }
        @if (cac.Count == 0) { <div class="small text-muted">Thay đổi Chuẩn — không cần duyệt từng lần.</div> }
        <ul class="list-unstyled mb-2">@foreach (var b in cac) { <li>@if (Model.DaDuyetBuoc(b)) { <i class="bi bi-check-circle text-success"></i> } else { <i class="bi bi-circle text-muted"></i> } @b.Ten() @(b switch { BuocDuyetThayDoi.Cntt => Model.NguoiDuyetCntt is null ? "" : $"— {Model.NguoiDuyetCntt} {Model.NgayDuyetCntt:dd/MM/yyyy}", BuocDuyetThayDoi.ChuSoHuu => Model.NguoiDuyetChuSoHuu is null ? "" : $"— {Model.NguoiDuyetChuSoHuu} {Model.NgayDuyetChuSoHuu:dd/MM/yyyy}", _ => Model.NguoiDuyetLanhDao is null ? "" : $"— {Model.NguoiDuyetLanhDao} {Model.NgayDuyetLanhDao:dd/MM/yyyy}" })</li> }</ul>
        @if (!string.IsNullOrEmpty(Model.LyDoTuChoi)) { <div class="small text-danger mb-2">Từ chối: @Model.LyDoTuChoi</div> }
        <div class="d-flex flex-wrap gap-2">
        @if (cntt && Model.TrangThai == TrangThaiThayDoi.Nhap && Model.Loai != LoaiThayDoi.Chuan) { <form asp-action="GuiDuyet" asp-route-id="@Model.Id" method="post"><button class="btn btn-sm btn-primary">Gửi duyệt</button></form> }
        @if (buocTiep is { } bt && DuocDuyet(bt)) { <form asp-action="Duyet" asp-route-id="@Model.Id" method="post"><input type="hidden" name="buoc" value="@bt" /><button class="btn btn-sm btn-success">Duyệt (@bt.Ten())</button></form> }
        @if (Model.TrangThai == TrangThaiThayDoi.ChoDuyet && (qCntt || qLd)) { <form asp-action="TuChoi" asp-route-id="@Model.Id" method="post" class="d-flex gap-1"><input name="lyDo" class="form-control form-control-sm" placeholder="Lý do từ chối" aria-label="Lý do từ chối" /><button class="btn btn-sm btn-outline-danger">Từ chối</button></form> }
        @if (cntt && ((Model.Loai == LoaiThayDoi.Chuan && Model.TrangThai == TrangThaiThayDoi.Nhap) || (Model.LaKhanCap && Model.TrangThai is TrangThaiThayDoi.Nhap or TrangThaiThayDoi.ChoDuyet) || Model.TrangThai == TrangThaiThayDoi.DaDuyet)) { <form asp-action="BatDau" asp-route-id="@Model.Id" method="post"><button class="btn btn-sm btn-outline-primary">@(Model.LaKhanCap ? "Thực hiện ngay (khẩn cấp)" : "Bắt đầu thực hiện")</button></form> }
        </div></div></div>

    @if (Model.AnhHuongChamSoc)
    {
        <div class="card mb-3"><div class="card-header">Đánh giá rủi ro trước thực hiện (PCRA) <span class="small fw-normal text-muted">FMS.10.00 ME1–ME3</span></div><div class="card-body">
        @if (cntt && Model.TrangThai is TrangThaiThayDoi.Nhap or TrangThaiThayDoi.ChoDuyet)
        {
            <form asp-action="LuuPcra" asp-route-id="@Model.Id" method="post">
            @foreach (var m in Model.MucPcras.OrderBy(x => x.Nhom)) { <div class="row g-2 mb-1 align-items-center"><div class="col-md-4 small">@m.Nhom.Ten()<input type="hidden" name="nhom" value="@((int)m.Nhom)" /></div>
                <div class="col-md-6"><input name="noiDung" value="@m.NoiDung" class="form-control form-control-sm" placeholder="Rủi ro và biện pháp / lý do không áp dụng" aria-label="@m.Nhom.Ten()" /></div>
                <div class="col-md-2"><div class="form-check"><input class="form-check-input" type="checkbox" name="khongApDung" value="@((int)m.Nhom)" id="ka@((int)m.Nhom)" checked="@(!m.ApDung)" /><label class="form-check-label small" for="ka@((int)m.Nhom)">Không áp dụng</label></div></div></div> }
            <button class="btn btn-sm btn-outline-primary mt-2">Lưu PCRA</button></form>
        }
        else { <table class="table table-sm mb-2"><tbody>@foreach (var m in Model.MucPcras.OrderBy(x => x.Nhom)) { <tr><td class="small">@m.Nhom.Ten()</td><td class="small">@(m.ApDung ? "" : "Không áp dụng: ")@m.NoiDung</td></tr> }</tbody></table> }
        @if (cntt && !Model.DaKetThuc) { <form asp-action="LuuPcraKhac" asp-route-id="@Model.Id" method="post" class="row g-2 mt-1">
            <div class="col-12"><input name="bienPhapAnToan" value="@Model.BienPhapAnToan" class="form-control form-control-sm" placeholder="Biện pháp bảo đảm an toàn người bệnh (quy trình giấy, ngoài giờ cao điểm)" aria-label="Biện pháp" /></div>
            <div class="col-md-4"><input name="nguoiPhuTrachKhoa" value="@Model.NguoiPhuTrachKhoa" class="form-control form-control-sm" placeholder="Người phụ trách tại khoa" aria-label="Người phụ trách tại khoa" /></div>
            <div class="col-md-3"><input name="nhaThau" value="@Model.NhaThau" class="form-control form-control-sm" placeholder="Nhà thầu (nếu có)" aria-label="Nhà thầu" /></div>
            <div class="col-md-5"><input name="giamSatNhaThau" value="@Model.GiamSatNhaThau" class="form-control form-control-sm" placeholder="Giám sát và hồ sơ tuân thủ của nhà thầu" aria-label="Giám sát nhà thầu" /></div>
            <div class="col-12"><button class="btn btn-sm btn-outline-primary">Lưu</button></div></form> }
        else { <div class="small">An toàn người bệnh: @Model.BienPhapAnToan · Phụ trách khoa: @Model.NguoiPhuTrachKhoa @(string.IsNullOrEmpty(Model.NhaThau) ? "" : "· Nhà thầu: " + Model.NhaThau + " — " + Model.GiamSatNhaThau)</div> }
        </div></div>
    }

    @if (Model.Loai == LoaiThayDoi.TrienKhaiMoi)
    {
        <div class="card mb-3"><div class="card-header">Đánh giá trước triển khai hệ thống mới <span class="small fw-normal text-muted">FR-TD-06 · HCT.01.00 ME3 / HCT.01.03</span></div><div class="card-body">
        <form asp-action="LuuChecklist" asp-route-id="@Model.Id" method="post">
        @foreach (var m in Model.Checklist) { <div class="row g-2 mb-1 align-items-center"><div class="col-md-5 small"><div class="form-check"><input type="hidden" name="mucId" value="@m.Id" /><input class="form-check-input" type="checkbox" name="dat" value="@m.Id" id="c@(m.Id)" checked="@m.Dat" disabled="@(!cntt)" /><label class="form-check-label" for="c@(m.Id)">@m.Ten</label></div></div>
            <div class="col-md-7"><input name="ghiChu" value="@m.GhiChu" class="form-control form-control-sm" placeholder="Ghi chú / bằng chứng" aria-label="Ghi chú @m.Ten" disabled="@(!cntt)" /></div></div> }
        @if (cntt) { <button class="btn btn-sm btn-outline-primary mt-2">Lưu checklist</button> }</form>
        @if (Model.HeThongMoiId is null && cntt && Model.Checklist.Count > 0 && Model.Checklist.All(x => x.Dat)) { <form asp-action="TaoHeThongMoi" asp-route-id="@Model.Id" method="post" class="d-flex gap-2 mt-3"><input name="ma" class="form-control form-control-sm" style="max-width:200px" placeholder="Mã hệ thống mới" aria-label="Mã hệ thống" /><button class="btn btn-sm btn-success">Tạo bản ghi hệ thống (Đang triển khai)</button></form> }
        @if (Model.HeThongMoiId is { } hm) { <div class="small mt-2">Hệ thống mới: <a asp-controller="HeThong" asp-action="Details" asp-route-id="@hm">xem hồ sơ</a></div> }
        </div></div>
    }

    @if (Model.TrangThai == TrangThaiThayDoi.DangThucHien && cntt)
    {
        <div class="card mb-3"><div class="card-header">Ghi kết quả thực hiện <span class="small fw-normal text-muted">FR-TD-05</span></div><div class="card-body"><form asp-action="KetQua" asp-route-id="@Model.Id" method="post" class="row g-2">
            <div class="col-md-4"><label class="form-label small mb-0" for="kq">Kết quả</label><select id="kq" name="ketQua" class="form-select form-select-sm"><option value="HoanThanh">Thành công</option><option value="DaQuayLui">Đã quay lui</option><option value="ThatBai">Thất bại</option></select></div>
            <div class="col-md-4 pt-4"><div class="form-check"><input class="form-check-input" type="checkbox" name="coVanDe" value="true" id="cvd" /><label class="form-check-label small" for="cvd">Thành công nhưng có vấn đề phát sinh</label></div></div>
            <div class="col-12"><textarea name="ketQuaMoTa" class="form-control form-control-sm" rows="2" placeholder="Mô tả kết quả, vấn đề phát sinh" aria-label="Kết quả"></textarea></div>
            <div class="col-md-6"><input name="kiemThuSau" class="form-control form-control-sm" placeholder="Kết quả kiểm thử sau thay đổi" aria-label="Kiểm thử" /></div>
            <div class="col-md-6"><input name="nguoiXacNhanNghiepVu" class="form-control form-control-sm" placeholder="Người dùng nghiệp vụ xác nhận@(Model.LaThayDoiLon ? " (bắt buộc)" : "")" aria-label="Người xác nhận" /></div>
            <div class="col-12"><button class="btn btn-sm btn-primary">Ghi kết quả</button></div></form></div></div>
    }
    @if (Model.DaKetThuc && Model.TrangThai != TrangThaiThayDoi.TuChoi)
    {
        <div class="card mb-3"><div class="card-header">Kết quả</div><div class="card-body small"><div>@Html.Raw(Badge.Html(Model.TrangThai)) @(Model.CoVanDe ? "có vấn đề" : "") · @Model.BatDauThucTe?.ToString("dd/MM/yyyy HH:mm") → @Model.KetThucThucTe?.ToString("dd/MM/yyyy HH:mm")</div><div style="white-space:pre-line">@Model.KetQua</div><div>Kiểm thử: @Model.KiemThuSau</div>
            @if (Model.NguoiXacNhanNghiepVu is not null) { <div>Người dùng nghiệp vụ xác nhận: @Model.NguoiXacNhanNghiepVu @Model.NgayXacNhanNghiepVu?.ToString("dd/MM/yyyy")</div> }</div></div>
    }
    @if (Model.DanhGiaSau is { } dg)
    {
        <div class="card mb-3"><div class="card-header">Đánh giá sau triển khai <span class="small fw-normal text-muted">FR-TD-09 · HCT.01.00 ME4</span> @if (!dg.DaDanhGia) { <span class="badge bg-warning text-dark ms-1">Hạn @dg.Han.ToString("dd/MM/yyyy")</span> }</div><div class="card-body">
        @if (dg.DaDanhGia) { <dl class="row info mb-0 small"><div class="col-sm-6"><dt>Tính dễ dùng</dt><dd>@dg.DeDung</dd></div><div class="col-sm-6"><dt>Dùng đúng mục đích</dt><dd>@dg.DungMucDich</dd></div><div class="col-sm-6"><dt>Tích hợp</dt><dd>@dg.TichHop</dd></div><div class="col-sm-6"><dt>An toàn người bệnh / sai sót</dt><dd>@dg.AnToanNguoiBenh</dd></div><div class="col-sm-6"><dt>Tác động nhân viên</dt><dd>@dg.TacDongNhanVien</dd></div><div class="col-12"><dt>Kết luận</dt><dd>@dg.KetLuan — @dg.NguoiDanhGia @dg.NgayDanhGia?.ToString("dd/MM/yyyy")</dd></div></dl> }
        else if (cntt) { <form asp-action="DanhGiaSau" asp-route-id="@Model.Id" method="post" class="row g-2">
            <div class="col-md-6"><input name="deDung" class="form-control form-control-sm" placeholder="Tính dễ dùng" aria-label="Dễ dùng" /></div><div class="col-md-6"><input name="dungMucDich" class="form-control form-control-sm" placeholder="Sử dụng đúng mục đích" aria-label="Đúng mục đích" /></div>
            <div class="col-md-6"><input name="tichHop" class="form-control form-control-sm" placeholder="Mức tích hợp với hệ thống hiện có" aria-label="Tích hợp" /></div><div class="col-md-6"><input name="anToan" class="form-control form-control-sm" placeholder="Tác động tới an toàn người bệnh / sai sót *" aria-label="An toàn" /></div>
            <div class="col-md-6"><input name="tacDong" class="form-control form-control-sm" placeholder="Tác động tới nhân viên" aria-label="Nhân viên" /></div><div class="col-md-6"><input name="ketLuan" class="form-control form-control-sm" placeholder="Kết luận và cải tiến *" aria-label="Kết luận" /></div>
            <div class="col-12"><button class="btn btn-sm btn-primary">Ghi đánh giá</button></div></form> }
        </div></div>
    }
</div><div class="col-lg-4">
    @await Html.PartialAsync("_DinhKem", (DoiTuong: "PhieuThayDoi", DoiTuongId: Model.Id.ToString(), Teps: (List<TepDinhKem>)ViewBag.Tep, DuocTaiLen: cntt))
    <div class="card mt-3"><div class="card-header">Hành động khắc phục</div><div class="card-body small">
        @foreach (var h in hds) { <div><a asp-controller="HanhDong" asp-action="Details" asp-route-id="@h.Id">@h.Ma</a> @h.MoTa — @h.NguoiChiuTrachNhiem</div> }
        @if (hds.Count == 0) { <div class="text-muted">Chưa có.</div> }
        @if (cntt && Model.DaKetThuc) { <form asp-action="TaoHanhDong" asp-route-id="@Model.Id" method="post" class="mt-2"><input name="moTa" class="form-control form-control-sm mb-1" placeholder="Nội dung" aria-label="Nội dung" /><input name="nguoiChiuTrachNhiem" class="form-control form-control-sm mb-1" placeholder="Người chịu trách nhiệm (tài khoản)" aria-label="Người chịu trách nhiệm" /><button class="btn btn-sm btn-outline-primary">Tạo</button></form> }
    </div></div>
</div></div>
