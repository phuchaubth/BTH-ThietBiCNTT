@model List<DonMuaHang>
@{ ViewData["Title"] = "Đơn mua hàng"; var homNay = DateOnly.FromDateTime(DateTime.Today); }
<div class="page-head"><h1>Mua sắm</h1>
    <div class="actions">@if (User.LaCNTT()) { <a asp-action="LapDon" class="btn btn-sm btn-primary"><i class="bi bi-cart-plus"></i> Lập đơn hàng</a> }</div>
</div>
<partial name="_Tabs" />
<form method="get" class="d-flex flex-wrap gap-2 mb-3 align-items-center">
    <select name="trangThai" class="form-select form-select-sm" style="width:220px" asp-items="@EnumExtensions.ToSelectList((TrangThaiDonHang?)ViewData["trangThai"])" aria-label="Trạng thái"><option value="">— Mọi trạng thái —</option></select>
    <div class="form-check"><input class="form-check-input" type="checkbox" name="treHan" value="true" id="treHan" @((bool)ViewData["treHan"]! ? "checked" : "") /><label class="form-check-label small" for="treHan">Quá hạn giao</label></div>
    <button class="btn btn-sm btn-outline-secondary">Lọc</button>
</form>
<div class="card"><div class="table-responsive"><table class="table table-sm table-hover mb-0 align-middle">
    <thead><tr><th>Số đơn</th><th>Ngày lập</th><th>Nhà cung cấp</th><th>Hạn giao</th><th class="text-end">Tổng tiền (gồm thuế)</th><th>Trạng thái</th></tr></thead>
    <tbody>
    @foreach (var d in Model)
    {
        <tr><td class="fw-semibold"><a asp-action="DonHang" asp-route-id="@d.Id">@d.SoPhieu</a></td><td class="small">@d.NgayTao.ToString("dd/MM/yy")</td><td>@d.NhaCungCap?.Ten</td>
            <td class="small @(d.TreHan(homNay) ? "text-danger fw-semibold" : "")">@d.HanGiao?.ToString("dd/MM/yyyy") @(d.TreHan(homNay) ? "· quá hạn" : "")</td>
            <td class="text-end">@d.TongTien.ToString("N0")</td><td>@Html.Raw(Badge.Html(d.TrangThai))</td></tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có đơn hàng.</td></tr> }
    </tbody>
</table></div></div>
