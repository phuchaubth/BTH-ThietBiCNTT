@model List<QuyTacCanhBao>
@{
    ViewData["Title"] = "Quy tắc cảnh báo";
    var truong = (Dictionary<DoiTuongCanhBao, List<TruongCanhBao>>)ViewBag.Truong;
    string Ten(QuyTacCanhBao q, string ma) => truong.GetValueOrDefault(q.DoiTuong)?.FirstOrDefault(t => t.Ma == ma)?.Ten ?? ma;
}
<div class="page-head"><h1>Quy tắc cảnh báo tuỳ chỉnh</h1>
    <div class="actions"><a asp-action="Form" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> Thêm quy tắc</a></div></div>
<p class="text-muted small">Hệ thống đánh giá các quy tắc đang bật 5 phút/lần. Mỗi đối tượng chỉ được báo một lần cho tới khi hết thoả điều kiện (hoặc theo chu kỳ nhắc lại).
    Từ @QuyTacCanhBaoService.GopKhiQua đối tượng trở lên trong một lượt sẽ được gộp thành một thông báo. Các cảnh báo cố định (SLA, bảo hành, tồn kho…) vẫn chạy song song theo tham số hệ thống.</p>
<div class="card"><div class="table-responsive"><table class="table table-sm table-hover mb-0 align-middle">
    <thead><tr><th>Quy tắc</th><th>Đối tượng</th><th>Điều kiện</th><th>Người nhận / hành động</th><th>Lần chạy cuối</th><th class="text-end">Đã gửi</th><th></th></tr></thead>
    <tbody>
    @foreach (var q in Model)
    {
        <tr class="@(q.DangBat ? "" : "text-muted")">
            <td><a asp-action="Form" asp-route-id="@q.Id" class="fw-semibold">@q.Ten</a>
                @if (!q.DangBat) { <span class="badge bg-light text-muted border">Tắt</span> }
                @if (q.MucDo == MucDoThongBao.KhanCap) { <span class="badge bg-danger">Khẩn</span> }
                @if (q.LoiCuoi is not null) { <div class="small text-danger" title="@q.LoiCuoi"><i class="bi bi-exclamation-triangle"></i> Lỗi lần chạy cuối</div> }</td>
            <td class="small">@q.DoiTuong.Ten()
                @if (q.KhoaPhong is not null) { <div class="text-muted">@q.KhoaPhong.Ten</div> }
                @if (q.LoaiThietBi is not null) { <div class="text-muted">@q.LoaiThietBi.Ten</div> }
                @if (q.UuTienTu is not null) { <div class="text-muted">Ưu tiên ≥ @q.UuTienTu.Value.Ten()</div> }</td>
            <td class="small">@q.MoTaDieuKien(m => Ten(q, m))</td>
            <td class="small">@string.Join(", ", q.DsNguoiNhan.Concat(q.DsVaiTro.Select(VaiTro.TenHienThi)).Concat(q.GuiNguoiPhuTrach ? ["Người phụ trách"] : []).Concat(q.GuiTruongKhoa ? ["Trưởng khoa"] : []))
                @if (q.NhacLaiSauGio > 0) { <div class="text-muted">Nhắc lại mỗi @q.NhacLaiSauGio giờ</div> }
                @if (q.HanhDong != HanhDongCanhBao.KhongCo) { <div class="text-primary">→ @q.HanhDong.Ten()</div> }</td>
            <td class="small text-nowrap">@q.LanChayCuoi?.ToString("dd/MM HH:mm")</td>
            <td class="text-end">@q.SoLanGui</td>
            <td class="text-nowrap">
                <a asp-action="ChayThu" asp-route-id="@q.Id" class="btn btn-sm btn-outline-secondary">Chạy thử</a>
                <form asp-action="BatTat" asp-route-id="@q.Id" method="post" class="d-inline"><button class="btn btn-sm @(q.DangBat ? "btn-outline-warning" : "btn-outline-success")">@(q.DangBat ? "Tắt" : "Bật")</button></form>
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">Chưa có quy tắc.</td></tr> }
    </tbody>
</table></div></div>
