@model AppUser
@{ ViewData["Title"] = "Xác thực 2 lớp"; }
<div class="small text-muted mb-1"><a asp-action="Index">Tài khoản của tôi</a> › Xác thực 2 lớp</div>
<div class="page-head"><h1><i class="bi bi-shield-lock"></i> Xác thực 2 lớp</h1></div>
@if ((bool)ViewData["batBuoc"]! && !Model.TwoFactorEnabled)
{
    <div class="alert alert-warning">Tài khoản Quản trị / Cán bộ CNTT <b>bắt buộc</b> bật xác thực 2 lớp trước khi sử dụng hệ thống.</div>
}
@if (TempData["maKhoiPhuc"] is string mkp)
{
    <div class="alert alert-info"><b>Mã khôi phục</b> — mỗi mã dùng được một lần khi mất điện thoại. Lưu/in ra và cất nơi an toàn; trang này sẽ không hiển thị lại:
        <div class="row row-cols-2 row-cols-md-5 g-1 mt-2 font-monospace" id="dsMa">@foreach (var m in mkp.Split(' ')) { <div class="col"><code>@m</code></div> }</div></div>
}
<div class="card" style="max-width:720px"><div class="card-body">
@if (Model.TwoFactorEnabled)
{
    <p><span class="badge bg-success"><i class="bi bi-check2"></i> Đang bật</span> Mỗi lần đăng nhập cần mã 6 số từ ứng dụng xác thực. Còn <b>@ViewBag.SoMaKhoiPhuc</b> mã khôi phục.</p>
    <form asp-action="TaoMaKhoiPhuc" method="post" class="mb-3" onsubmit="return confirm('Tạo bộ mã mới? Các mã cũ sẽ hết hiệu lực.')"><button class="btn btn-sm btn-outline-primary">Tạo bộ mã khôi phục mới</button></form>
    <form asp-action="TatXacThuc2Lop" method="post" class="d-flex gap-2 align-items-end border-top pt-3">
        <div><label class="form-label small" for="maTat">Nhập mã hiện tại để tắt</label><input name="ma" id="maTat" class="form-control form-control-sm font-monospace" inputmode="numeric" required style="width:140px" /></div>
        <button class="btn btn-sm btn-outline-danger">Tắt xác thực 2 lớp</button>
    </form>
}
else
{
    <ol class="mb-3">
        <li>Cài <b>Google Authenticator</b> hoặc <b>Microsoft Authenticator</b> trên điện thoại.</li>
        <li>Trong ứng dụng chọn <i>Thêm tài khoản → Quét mã QR</i> và quét mã bên dưới (hoặc nhập khoá thủ công).</li>
        <li>Nhập mã 6 số ứng dụng hiển thị để xác nhận.</li>
    </ol>
    <div class="d-flex flex-wrap gap-4 align-items-center">
        <img src="@ViewBag.Qr" alt="Mã QR cài ứng dụng xác thực" width="200" height="200" class="border rounded" />
        <div><div class="small text-muted">Khoá nhập thủ công</div><div class="font-monospace fs-6" id="khoa">@ViewBag.Khoa</div>
            <form asp-action="BatXacThuc2Lop" method="post" class="mt-3 d-flex gap-2"><input name="ma" class="form-control font-monospace" style="width:140px" inputmode="numeric" autocomplete="one-time-code" placeholder="123456" aria-label="Mã 6 số" required />
                <button class="btn btn-primary">Xác nhận & bật</button></form></div>
    </div>
}
</div></div>
