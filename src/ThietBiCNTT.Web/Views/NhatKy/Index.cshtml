@model List<NhatKyHeThong>
@{
    ViewData["Title"] = "Nhật ký hệ thống"; var page = (int)ViewData["page"]!; dynamic loc = ViewBag.Loc;
    var qs = Context.Request.QueryString.Value ?? "";
    string Trang(int p) => "?" + System.Text.RegularExpressions.Regex.Replace(qs.TrimStart('?'), @"(^|&)page=\d+", "") + $"&page={p}";
}
<div class="page-head"><h1>Nhật ký hệ thống</h1>
    <div class="actions"><a href="/NhatKy/Xuat@(qs)" class="btn btn-sm btn-outline-success"><i class="bi bi-file-earmark-excel"></i> Xuất Excel</a></div></div>
@if ((int)ViewBag.LoiDangNhap > 0) { <div class="alert alert-warning small py-2"><a href="?hanhDong=@ThaoTac.DangNhapLoi&tu=@DateTime.Today.ToString("yyyy-MM-dd")">@ViewBag.LoiDangNhap lượt đăng nhập lỗi hôm nay</a></div> }
<form class="d-flex flex-wrap gap-2 mb-3" method="get">
    <select name="hanhDong" class="form-select form-select-sm" style="width:200px" aria-label="Thao tác"><option value="">— Mọi thao tác —</option>
        @foreach (var h in ThaoTac.TatCa) { <option value="@h" selected="@(h == (string?)loc.hanhDong)">@ThaoTac.Ten(h)</option> }</select>
    <input name="nguoi" value="@loc.nguoi" class="form-control form-control-sm" style="width:130px" placeholder="Người dùng" aria-label="Người dùng" />
    <input name="doiTuong" value="@loc.doiTuong" class="form-control form-control-sm" style="width:160px" placeholder="Đối tượng (TaiSan…)" aria-label="Đối tượng" />
    <input name="ip" value="@loc.ip" class="form-control form-control-sm" style="width:130px" placeholder="IP" aria-label="IP" />
    <input name="tu" type="date" value="@(((DateTime?)loc.tu)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" style="width:150px" aria-label="Từ ngày" />
    <input name="den" type="date" value="@(((DateTime?)loc.den)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" style="width:150px" aria-label="Đến ngày" />
    <input name="q" value="@loc.q" class="form-control form-control-sm" style="width:160px" placeholder="Id / nội dung" aria-label="Tìm trong chi tiết" />
    <button class="btn btn-sm btn-outline-secondary">Lọc</button>
</form>
<div class="small text-muted mb-2">Nhật ký chỉ ghi thêm, không ai sửa/xoá được (kể cả Quản trị). Giá trị trường nhạy cảm (khoá kích hoạt, khoá API) được che "***".</div>
<div class="card"><div class="table-responsive"><table class="table table-sm mb-0">
<thead><tr><th>Thời gian</th><th>Người dùng</th><th>IP</th><th>Thao tác</th><th>Đối tượng</th><th>Id</th><th>Chi tiết</th></tr></thead>
<tbody>@foreach (var n in Model) {
<tr class="@(n.HanhDong == ThaoTac.DangNhapLoi ? "table-warning" : n.HanhDong == ThaoTac.Xem ? "table-info" : "")"><td class="text-nowrap small">@n.ThoiGian.ToString("dd/MM/yyyy HH:mm:ss")</td><td>@n.NguoiDung</td><td class="small font-monospace">@n.DiaChiIp</td>
    <td class="small">@ThaoTac.Ten(n.HanhDong)</td><td class="small">@n.DoiTuong</td><td class="small">@n.DoiTuongId</td><td class="small text-muted text-break" style="max-width:480px">@n.ChiTiet</td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">Không có bản ghi.</td></tr> }</tbody></table></div></div>
<div class="mt-2"><a class="btn btn-sm btn-outline-secondary @(page<=1?"disabled":"")" href="@Trang(page - 1)">« Trước</a>
<a class="btn btn-sm btn-outline-secondary @(Model.Count<50?"disabled":"")" href="@Trang(page + 1)">Sau »</a></div>
