@model List<NhatKyHeThong>
@{ ViewData["Title"] = "Nhật ký hệ thống"; var page = (int)ViewData["page"]!; }
<div class="page-head"><h1>Nhật ký hệ thống</h1>
<form class="d-flex gap-2 ms-3" method="get">
    <input name="doiTuong" value="@ViewData["doiTuong"]" class="form-control form-control-sm" placeholder="Đối tượng (TaiSan, PhieuSuaChua…)" />
    <input name="nguoi" value="@ViewData["nguoi"]" class="form-control form-control-sm" placeholder="Người dùng" />
    <button class="btn btn-sm btn-outline-secondary">Lọc</button>
</form></div>
<div class="card"><div class="table-responsive"><table class="table table-sm mb-0">
<thead><tr><th>Thời gian</th><th>Người dùng</th><th>Thao tác</th><th>Đối tượng</th><th>Id</th><th>Chi tiết</th></tr></thead>
<tbody>@foreach (var n in Model) {
<tr><td class="text-nowrap">@n.ThoiGian.ToString("dd/MM/yyyy HH:mm:ss")</td><td>@n.NguoiDung</td><td>@n.HanhDong</td><td>@n.DoiTuong</td><td>@n.DoiTuongId</td><td class="small text-muted text-break" style="max-width:520px">@n.ChiTiet</td></tr>
}</tbody></table></div></div>
<div class="mt-2"><a class="btn btn-sm btn-outline-secondary @(page<=1?"disabled":"")" href="?page=@(page-1)&doiTuong=@ViewData["doiTuong"]&nguoi=@ViewData["nguoi"]">« Trước</a>
<a class="btn btn-sm btn-outline-secondary @(Model.Count<50?"disabled":"")" href="?page=@(page+1)&doiTuong=@ViewData["doiTuong"]&nguoi=@ViewData["nguoi"]">Sau »</a></div>
