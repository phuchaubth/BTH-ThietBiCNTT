@model BaiTapChuDong
@{ ViewData["Title"] = Model.QuyTrinh; var cntt = User.LaCNTT(); var hds = (List<HanhDongKhacPhuc>)ViewBag.HanhDong; }
<div class="small text-muted mb-1"><a asp-action="Index">Bài tập chủ động</a> › @Model.QuyTrinh</div>
<div class="page-head"><h1>@Model.QuyTrinh (@Model.Nam)</h1>@if (Model.DaChot) { <span class="badge bg-success">Đã chốt</span> } else if (cntt) { <div class="actions"><a asp-action="Form" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">Sửa</a><form asp-action="Chot" asp-route-id="@Model.Id" method="post" class="d-inline"><button class="btn btn-sm btn-success">Chốt</button></form></div> }</div>
<div class="row g-3"><div class="col-lg-8"><div class="card"><div class="card-body"><dl class="row info mb-0">
    <div class="col-12"><dt>Điểm có thể hỏng</dt><dd style="white-space:pre-line">@Model.DiemCoTheHong</dd></div><div class="col-12"><dt>Hậu quả</dt><dd style="white-space:pre-line">@Model.HauQua</dd></div><div class="col-12"><dt>Biện pháp / thiết kế lại quy trình</dt><dd style="white-space:pre-line">@Model.BienPhap</dd></div>
    <div class="col-sm-6"><dt>Thành phần tham gia</dt><dd>@Model.ThamGia</dd></div><div class="col-sm-6"><dt>Diễn tập liên quan</dt><dd>@if (Model.DotDienTap is not null) { <a asp-controller="DienTap" asp-action="Details" asp-route-id="@Model.DotDienTapId">@Model.DotDienTap.HanThucHien</a> }</dd></div></dl></div></div></div>
<div class="col-lg-4">@await Html.PartialAsync("_DinhKem", (DoiTuong: "BaiTapChuDong", DoiTuongId: Model.Id.ToString(), Teps: (List<TepDinhKem>)ViewBag.Tep, DuocTaiLen: cntt))
    <div class="card mt-3"><div class="card-header">Việc thiết kế lại quy trình</div><div class="card-body small">@foreach (var h in hds) { <div><a asp-controller="HanhDong" asp-action="Details" asp-route-id="@h.Id">@h.Ma</a> @h.MoTa</div> }
        @if (cntt) { <form asp-action="TaoHanhDong" asp-route-id="@Model.Id" method="post" class="mt-2"><input name="moTa" class="form-control form-control-sm mb-1" placeholder="Nội dung" aria-label="Nội dung" /><input name="nguoiChiuTrachNhiem" class="form-control form-control-sm mb-1" placeholder="Người chịu trách nhiệm" aria-label="Người chịu trách nhiệm" /><button class="btn btn-sm btn-outline-primary">Tạo</button></form> }</div></div></div></div>
