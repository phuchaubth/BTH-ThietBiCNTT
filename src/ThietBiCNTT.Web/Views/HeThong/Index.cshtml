@model List<DongHeThong>
@{
    ViewData["Title"] = "Hệ thống thông tin";
    var muc = ViewData["muc"] as MucTrongYeu?; var tt = ViewData["trangThai"] as TrangThaiHeThong?; var chiCb = (bool)ViewData["chiCanhBao"]!;
}
<div class="page-head"><h1>Hệ thống thông tin</h1>
    <span class="text-muted small">Danh mục, mức trọng yếu, RTO/RPO và phụ thuộc hạ tầng (HCT.01.00, MOI.01.00)</span>
    <div class="actions">
        @if (User.XemToanVien()) { <a asp-action="AnhHuong" class="btn btn-sm btn-outline-secondary"><i class="bi bi-diagram-3"></i> Phân tích ảnh hưởng</a> }
        @if (User.LaCNTT()) { <a asp-action="Form" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> Thêm hệ thống</a> }
    </div></div>
<form method="get" class="d-flex flex-wrap gap-2 mb-3">
    <select name="muc" class="form-select form-select-sm" style="width:190px" asp-items="@EnumExtensions.ToSelectList(muc)" aria-label="Mức trọng yếu"><option value="">— Mọi mức trọng yếu —</option></select>
    <select name="trangThai" class="form-select form-select-sm" style="width:190px" asp-items="@EnumExtensions.ToSelectList(tt)" aria-label="Trạng thái"><option value="">— Đang sử dụng —</option></select>
    @if (User.XemToanVien()) { <select name="khoa" class="form-select form-select-sm" style="width:230px" asp-items="ViewBag.DsKhoa" aria-label="Khoa/phòng"><option value="">— Mọi khoa/phòng —</option></select> }
    <div class="form-check align-self-center"><input class="form-check-input" type="checkbox" name="chiCanhBao" value="true" id="cb" @(chiCb ? "checked" : "") /><label class="form-check-label small" for="cb">Chỉ hồ sơ có cảnh báo</label></div>
    <button class="btn btn-sm btn-outline-secondary">Lọc</button>
</form>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0 align-middle">
    <thead><tr><th>Mã</th><th>Hệ thống</th><th>Mức trọng yếu</th><th>Trạng thái</th><th>RTO / RPO</th><th>Phụ trách</th><th class="text-center">Khoa</th><th class="text-center">Phụ thuộc</th>@if (User.XemToanVien()) { <th>Cảnh báo hồ sơ</th> }</tr></thead>
    <tbody>
    @foreach (var d in Model)
    {
        var h = d.HeThong;
        <tr>
            <td class="fw-semibold"><a asp-action="Details" asp-route-id="@h.Id">@h.Ma</a></td>
            <td>@h.Ten<div class="small text-muted">@h.Loai.Ten()@(h.CapDoAttt is { } c ? $" · ATTT cấp {c}" : "")</div></td>
            <td>@Html.Raw(Badge.Html(h.MucTrongYeu))</td>
            <td>@Html.Raw(Badge.Html(h.TrangThai))</td>
            <td class="small text-nowrap">@(d.Rto >= 60 ? $"{d.Rto / 60.0:0.#} giờ" : $"{d.Rto} phút") / @(d.Rpo >= 60 ? $"{d.Rpo / 60.0:0.#} giờ" : $"{d.Rpo} phút")</td>
            <td class="small">@h.PhuTrachChinh</td>
            <td class="text-center">@d.SoKhoa</td><td class="text-center">@d.SoPhuThuoc</td>
            @if (User.XemToanVien())
            {
                <td class="small">@if (d.CanhBao.Count == 0) { <span class="text-success"><i class="bi bi-check-circle"></i> Đầy đủ</span> } else { <span class="text-danger">@string.Join("; ", d.CanhBao)</span> }</td>
            }
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="9" class="text-center text-muted py-4">Chưa có hệ thống thông tin nào.</td></tr> }
    </tbody>
</table></div></div>
