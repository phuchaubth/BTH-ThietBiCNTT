@model List<MayTramAgent>
@{
    ViewData["Title"] = "Máy trạm (agent)"; var chuan = (ChuanCauHinh)ViewBag.Chuan; var ngay = (int)ViewBag.Ngay; var now = DateTime.Now; var loc = ViewData["loc"] as string;
    string The(string? l, string ten, int so, string mau) => $"<a href=\"?loc={l}\" class=\"btn btn-sm {(loc == l ? "btn-" + mau : "btn-outline-" + mau)}\">{ten} <span class=\"badge bg-light text-dark\">{so}</span></a>";
}
<div class="page-head"><h1>Máy trạm có agent</h1>
    <div class="actions">
        <a asp-action="TaiScript" asp-route-ten="ThuThapCauHinh.ps1" class="btn btn-sm btn-outline-secondary"><i class="bi bi-download"></i> ThuThapCauHinh.ps1</a>
        <a asp-action="TaiScript" asp-route-ten="CaiDatAgent.ps1" class="btn btn-sm btn-outline-secondary"><i class="bi bi-download"></i> CaiDatAgent.ps1</a>
    </div>
</div>
<div class="d-flex flex-wrap gap-2 mb-3">
    @Html.Raw(The(null, "Tất cả", (int)ViewBag.TongSo, "secondary"))
    @Html.Raw(The("chuaghep", "Chưa ghép tài sản", (int)ViewBag.ChuaGhep, "warning"))
    @Html.Raw(The("khonggui", $"Không gửi > {ngay} ngày", (int)ViewBag.KhongGui, "danger"))
    @Html.Raw(The("khongdat", "Không đạt chuẩn HIS", (int)ViewBag.KhongDat, "danger"))
    <form method="get" class="ms-auto d-flex gap-2"><input type="hidden" name="loc" value="@loc" /><input name="q" value="@ViewData["q"]" class="form-control form-control-sm" placeholder="Hostname, IP, người dùng, phần mềm…" aria-label="Tìm" /><button class="btn btn-sm btn-outline-secondary">Tìm</button></form>
</div>
<div class="card"><div class="table-responsive"><table class="table table-sm table-hover mb-0 align-middle">
    <thead><tr><th>Hostname</th><th>Tài sản</th><th>Khoa</th><th>IP</th><th>HĐH</th><th class="text-end">RAM</th><th class="text-end">C: trống</th><th>Chuẩn HIS</th><th>Gửi lần cuối</th></tr></thead>
    <tbody>
    @foreach (var m in Model)
    {
        var dc = m.DoiChieu(chuan); var dat = dc.All(x => x.Dat);
        <tr><td class="fw-semibold"><a asp-action="ChiTiet" asp-route-id="@m.Id">@m.Hostname</a><div class="small text-muted">@m.NguoiDangNhap</div></td>
            <td>@if (m.TaiSan is not null) { <a asp-controller="TaiSan" asp-action="Details" asp-route-id="@m.TaiSanId">@m.TaiSan.MaTaiSan</a> } else { <span class="badge bg-warning text-dark">Chưa ghép</span> }</td>
            <td class="small">@m.TaiSan?.KhoaPhong?.Ten</td><td class="small">@m.Ip</td><td class="small">@m.HeDieuHanh</td>
            <td class="text-end">@m.RamGb?.ToString("0.#")</td><td class="text-end">@m.OCungTrongGb?.ToString("0")</td>
            <td>@if (dc.Count == 0) { <span class="text-muted small">—</span> } else if (dat) { <span class="badge bg-success">Đạt</span> } else { <span class="badge bg-danger" title="@string.Join("; ", dc.Where(x => !x.Dat).Select(x => x.TieuChi))">Không đạt @dc.Count(x => !x.Dat)</span> }</td>
            <td class="small @(m.KhongGui(now, ngay) ? "text-danger fw-semibold" : "")">@m.LanCuoi.ToString("dd/MM/yyyy HH:mm")</td></tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="9" class="text-center text-muted py-4">Chưa có máy nào gửi cấu hình. Tạo khoá API phạm vi <code>cauhinh.ghi</code> rồi cài agent qua GPO — xem hướng dẫn trong <code>docs/TrienKhaiIIS.md</code>.</td></tr> }
    </tbody>
</table></div></div>
