@model List<ViPhamTruyCap>
@{ ViewData["Title"] = "Giám sát tuân thủ truy cập"; var quy = (List<(int Quy, int Moi, int Dong)>)ViewBag.TheoQuy; int nam = ViewBag.Nam; }
<div class="page-head"><h1>Giám sát tuân thủ truy cập</h1><span class="text-muted small">MOI.01.01 ME6 – vi phạm truy cập / phát hành thông tin và hành động đã thực hiện</span>
    <div class="actions"><a asp-controller="RaSoatQuyen" asp-action="Index" class="btn btn-sm btn-outline-secondary">Rà soát quyền</a>@if (User.LaCNTT()) { <a asp-action="Create" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> Ghi nhận vi phạm</a> }</div></div>
<div class="row g-2 mb-3 text-center">@foreach (var q in quy) { <div class="col-6 col-md-3"><div class="card"><div class="card-body py-2"><div class="small text-muted">Quý @q.Quy/@nam</div><div>@q.Moi phát hiện · @q.Dong đã đóng</div></div></div></div> }</div>
<div class="card"><div class="table-responsive"><table class="table table-sm mb-0 align-top"><thead><tr><th>Ngày</th><th>Mô tả</th><th>Nguồn</th><th>Hệ thống / khoa</th><th>Trạng thái</th><th>Hành động</th></tr></thead><tbody>
@foreach (var v in Model) { <tr><td class="small">@v.NgayPhatHien.ToString("dd/MM/yyyy")</td><td>@if (v.NghiemTrong) { <span class="badge bg-danger">Nghiêm trọng</span> } @v.MoTa</td><td class="small">@v.Nguon.Ten()</td><td class="small">@v.HeThong?.Ma @v.KhoaPhong?.Ten</td><td><span class="badge bg-@(v.TrangThai == TrangThaiViPham.DaDong ? "success" : "warning text-dark")">@v.TrangThai.Ten()</span></td>
    <td class="small">@v.HanhDong @if (User.LaCNTT() && v.TrangThai != TrangThaiViPham.DaDong) { <form asp-action="XuLy" asp-route-id="@v.Id" method="post" class="d-flex gap-1 mt-1"><input name="hanhDong" class="form-control form-control-sm" placeholder="Hành động đã thực hiện" aria-label="Hành động" /><div class="form-check pt-1"><input class="form-check-input" type="checkbox" name="dong" value="true" id="d@(v.Id)" /><label class="form-check-label" for="d@(v.Id)">Đóng</label></div><button class="btn btn-sm btn-outline-primary">Lưu</button></form> }</td></tr> }
@if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-3">Chưa ghi nhận vi phạm.</td></tr> }
</tbody></table></div></div>
