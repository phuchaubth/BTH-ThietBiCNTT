@model (int Page, int TotalPages, int Total)
@{
    string Url(int p)
    {
        var q = Context.Request.Query.Where(x => x.Key != "page").Select(x => $"{x.Key}={Uri.EscapeDataString(x.Value.ToString())}").Append($"page={p}");
        return Context.Request.Path + "?" + string.Join("&", q);
    }
}
<div class="d-flex align-items-center justify-content-between mt-2 small">
    <span class="text-muted">Tổng: @Model.Total bản ghi</span>
    @if (Model.TotalPages > 1)
    {
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Url(Model.Page - 1)">«</a></li>
            @for (var i = Math.Max(1, Model.Page - 3); i <= Math.Min(Model.TotalPages, Model.Page + 3); i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" href="@Url(i)">@i</a></li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@Url(Model.Page + 1)">»</a></li>
        </ul>
    }
</div>
