@{ ViewData["Title"] = "Đổi mật khẩu"; }
<div class="page-head"><h1>Đổi mật khẩu</h1></div>
<div class="card" style="max-width:440px"><div class="card-body">
    @if (ViewData["Error"] is string e) { <div class="alert alert-danger small py-2">@e</div> }
    <form method="post" asp-action="DoiMatKhau">
        <div class="mb-3"><label class="form-label" for="c">Mật khẩu hiện tại</label><input id="c" name="matKhauCu" type="password" class="form-control" required autocomplete="current-password" /></div>
        <div class="mb-3"><label class="form-label" for="m">Mật khẩu mới</label><input id="m" name="matKhauMoi" type="password" class="form-control" required minlength="8" autocomplete="new-password" />
            <div class="form-text">Tối thiểu 8 ký tự, có chữ hoa, chữ thường và chữ số.</div></div>
        <div class="mb-3"><label class="form-label" for="n">Nhập lại mật khẩu mới</label><input id="n" name="nhapLai" type="password" class="form-control" required autocomplete="new-password" /></div>
        <button class="btn btn-primary">Đổi mật khẩu</button>
    </form>
</div></div>
