@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập - Quản lý TTB CNTT</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <style>body{background:linear-gradient(135deg,#0f2d4a,#1d5c96);min-height:100vh;display:flex;align-items:center;justify-content:center}</style>
</head>
<body>
<div class="card shadow" style="width:380px;max-width:92vw">
    <div class="card-body p-4">
        <div class="text-center mb-3">
            <i class="bi bi-hospital text-primary" style="font-size:2.5rem"></i>
            <h1 class="h5 mt-2 mb-0">Quản lý Trang thiết bị CNTT</h1>
            <div class="text-muted small">Phòng Công nghệ thông tin</div>
        </div>
        @if (ViewData["Error"] is string e) { <div class="alert alert-danger py-2 small">@e</div> }
        <form method="post" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
            <div class="mb-3"><label class="form-label">Tên đăng nhập</label><input name="userName" class="form-control" autofocus required /></div>
            <div class="mb-3"><label class="form-label">Mật khẩu</label><input name="password" type="password" class="form-control" required /></div>
            <div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="remember" value="true" id="r" /><label class="form-check-label" for="r">Ghi nhớ đăng nhập</label></div>
            <button class="btn btn-primary w-100">Đăng nhập</button>
        </form>
    </div>
</div>
</body>
</html>
