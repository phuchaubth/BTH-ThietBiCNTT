@model List<ThongBao>
@{ ViewData["Title"] = "Thông báo"; var chuaDoc = (bool)ViewData["chuaDoc"]!; var page = (int)ViewData["page"]!; }
<div class="page-head">
    <h1>Thông báo</h1>
    <div class="actions">
        <a asp-action="Index" asp-route-chuaDoc="@(!chuaDoc)" class="btn btn-sm @(chuaDoc ? "btn-primary" : "btn-outline-primary")">Chỉ chưa đọc</a>
        <form asp-action="DocTatCa" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary">Đánh dấu tất cả đã đọc</button></form>
        <a asp-controller="TaiKhoan" asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-gear"></i> Kênh nhận</a>
    </div>
</div>
<div class="card"><div class="list-group list-group-flush">
    @foreach (var t in Model)
    {
        var mau = t.MucDo switch { MucDoThongBao.KhanCap => "danger", MucDoThongBao.CanhBao => "warning", _ => "primary" };
        <a class="list-group-item list-group-item-action d-flex gap-3 @(t.DaDoc ? "" : "bg-primary-subtle")" asp-action="Mo" asp-route-id="@t.Id">
            <i class="bi bi-circle-fill text-@mau" style="font-size:.6rem;margin-top:.45rem" aria-hidden="true"></i>
            <div class="flex-fill"><div class="@(t.DaDoc ? "" : "fw-semibold")">@t.TieuDe</div>
                @if (t.NoiDung is not null) { <div class="small text-muted" style="white-space:pre-line">@t.NoiDung</div> }
                <div class="small text-muted">@t.Loai.Ten() · @t.ThoiGian.ToString("HH:mm dd/MM/yyyy")</div></div>
        </a>
    }
    @if (Model.Count == 0) { <div class="list-group-item text-muted text-center py-4">Không có thông báo.</div> }
</div></div>
<div class="mt-2"><a class="btn btn-sm btn-outline-secondary @(page <= 1 ? "disabled" : "")" href="?page=@(page - 1)&chuaDoc=@chuaDoc">« Mới hơn</a>
<a class="btn btn-sm btn-outline-secondary @(Model.Count < 50 ? "disabled" : "")" href="?page=@(page + 1)&chuaDoc=@chuaDoc">Cũ hơn »</a></div>
