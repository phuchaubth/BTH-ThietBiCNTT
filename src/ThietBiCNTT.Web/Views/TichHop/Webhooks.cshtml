@model List<Webhook>
@{ ViewData["Title"] = "Webhook"; var gui = (List<WebhookGui>)ViewBag.Gui; }
<div class="page-head"><h1>Tích hợp hệ thống</h1><div class="actions"><a asp-action="SuaWebhook" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> Thêm webhook</a></div></div>
<partial name="_Tabs" />
<div class="card mb-3"><div class="table-responsive"><table class="table table-sm mb-0 align-middle">
    <thead><tr><th>Tên</th><th>URL</th><th>Sự kiện</th><th>Bí mật HMAC</th><th></th></tr></thead>
    <tbody>@foreach (var w in Model) {
        <tr class="@(w.DangHoatDong ? "" : "text-muted")"><td class="fw-semibold">@w.Ten @if (!w.DangHoatDong) { <span class="badge bg-secondary">Tắt</span> }</td><td class="small"><code>@w.Url</code></td>
            <td class="small">@foreach (var s in w.SuKien.Split(',')) { <span class="badge bg-light text-dark border me-1">@s</span> }</td>
            <td><details><summary class="small">Xem</summary><code class="small">@w.BiMat</code></details></td>
            <td class="text-nowrap">
                <form asp-action="ThuGui" asp-route-id="@w.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary">Gửi thử</button></form>
                <a asp-action="SuaWebhook" asp-route-id="@w.Id" class="btn btn-sm btn-link">Sửa</a>
                <form asp-action="DoiBiMat" asp-route-id="@w.Id" method="post" class="d-inline" onsubmit="return confirm('Tạo bí mật mới? Bên nhận phải cập nhật theo.')"><button class="btn btn-sm btn-link">Đổi bí mật</button></form>
                <form asp-action="XoaWebhook" asp-route-id="@w.Id" method="post" class="d-inline" onsubmit="return confirm('Xoá webhook?')"><button class="btn btn-sm btn-link text-danger">Xoá</button></form></td></tr> }
    @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có webhook.</td></tr> }
    </tbody>
</table></div></div>
<div class="card"><div class="card-header">100 lần gửi gần nhất</div><div class="table-responsive"><table class="table table-sm mb-0 small align-middle">
    <thead><tr><th>#</th><th>Tạo lúc</th><th>Webhook</th><th>Sự kiện</th><th>Trạng thái</th><th class="text-end">Lần thử</th><th>HTTP / lỗi</th><th></th></tr></thead>
    <tbody>@foreach (var g in gui) {
        <tr><td>@g.Id</td><td class="text-nowrap">@g.ThoiGianTao.ToString("dd/MM HH:mm:ss")</td><td>@g.Webhook?.Ten</td><td><code>@g.SuKien</code></td>
            <td><span class="badge bg-@(g.TrangThai == TrangThaiGuiWebhook.DaGui ? "success" : g.TrangThai == TrangThaiGuiWebhook.Loi ? "danger" : "warning text-dark")">@g.TrangThai.Ten()</span>
                @if (g.TrangThai == TrangThaiGuiWebhook.Cho && g.SoLan > 0) { <div class="text-muted">thử lại @g.GuiTu.ToString("HH:mm")</div> }</td>
            <td class="text-end">@g.SoLan</td><td>@g.MaHttp @g.LoiCuoi</td>
            <td><details><summary>JSON</summary><pre class="small mb-0" style="max-width:420px;white-space:pre-wrap">@g.NoiDung</pre></details>
                @if (g.TrangThai != TrangThaiGuiWebhook.Cho) { <form asp-action="GuiLai" asp-route-id="@g.Id" method="post"><button class="btn btn-sm btn-link p-0">Gửi lại</button></form> }</td></tr> }
    @if (gui.Count == 0) { <tr><td colspan="8" class="text-center text-muted py-3">Chưa có.</td></tr> }
    </tbody>
</table></div></div>
