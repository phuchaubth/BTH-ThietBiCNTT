@model List<NhatKyApi>
@{ ViewData["Title"] = "Nhật ký gọi API"; var khoas = (List<KhoaApi>)ViewBag.Khoas; var chon = (int?)ViewData["khoaApiId"]; }
<div class="page-head"><h1>Tích hợp hệ thống</h1></div>
<partial name="_Tabs" />
<form method="get" class="d-flex flex-wrap gap-2 mb-3 align-items-center">
    <select name="khoaApiId" class="form-select form-select-sm" style="width:260px" aria-label="Khoá"><option value="">— Mọi khoá —</option>
        @foreach (var k in khoas) { <option value="@k.Id" selected="@(k.Id == chon)">@k.Ten</option> }</select>
    <div class="form-check"><input class="form-check-input" type="checkbox" name="loi" value="true" id="loi" @((bool)ViewData["loi"]! ? "checked" : "") /><label class="form-check-label small" for="loi">Chỉ lỗi (≥ 400)</label></div>
    <button class="btn btn-sm btn-outline-secondary">Lọc</button>
</form>
<div class="card"><div class="table-responsive"><table class="table table-sm mb-0 small">
    <thead><tr><th>Thời gian</th><th>Khoá</th><th>IP</th><th>Lời gọi</th><th class="text-end">HTTP</th><th class="text-end">ms</th></tr></thead>
    <tbody>@foreach (var x in Model) {
        <tr><td class="text-nowrap">@x.ThoiGian.ToString("dd/MM HH:mm:ss")</td><td>@(x.TenKhoa ?? "—")</td><td>@x.Ip</td><td><code>@x.Method @x.Path</code></td>
            <td class="text-end"><span class="badge bg-@(x.MaHttp < 300 ? "success" : x.MaHttp < 500 ? "warning text-dark" : "danger")">@x.MaHttp</span></td><td class="text-end">@x.ThoiGianMs</td></tr> }
    @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có lời gọi.</td></tr> }
    </tbody>
</table></div></div>
