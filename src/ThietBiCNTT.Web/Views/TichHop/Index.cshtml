@model List<KhoaApi>
@{ ViewData["Title"] = "Tích hợp – Khoá API"; var homNay = DateOnly.FromDateTime(DateTime.Today); }
<div class="page-head"><h1>Tích hợp hệ thống</h1></div>
<partial name="_Tabs" />
@if (TempData["khoaMoi"] is string moi)
{
    <div class="alert alert-warning">
        <b>Khoá API mới cho “@TempData["tenKhoaMoi"]”</b> — sao chép ngay, khoá chỉ hiển thị <b>một lần</b>:
        <div class="input-group mt-2"><input class="form-control font-monospace" id="khoaMoi" value="@moi" readonly aria-label="Khoá API mới" />
            <button class="btn btn-outline-dark" type="button" onclick="navigator.clipboard.writeText(document.getElementById('khoaMoi').value);this.textContent='Đã chép'">Sao chép</button></div>
        <div class="small mt-1">Gửi kèm mỗi lời gọi: <code>X-Api-Key: @moi[..12]…</code></div>
    </div>
}
<div class="row g-3">
<div class="col-lg-8"><div class="card"><div class="table-responsive"><table class="table table-sm mb-0 align-middle">
    <thead><tr><th>Tên</th><th>Khoá</th><th>Phạm vi</th><th>IP được phép</th><th>Dùng lần cuối</th><th></th></tr></thead>
    <tbody>
    @foreach (var k in Model)
    {
        var hl = k.CoHieuLuc(homNay);
        <tr class="@(hl ? "" : "text-muted")"><td class="fw-semibold">@k.Ten<div class="small text-muted">@k.NguoiTao · @k.NgayTao.ToString("dd/MM/yyyy")</div></td>
            <td><code>@k.TienTo…</code>@if (!hl) { <div><span class="badge bg-secondary">@(k.DangHoatDong ? "Hết hạn" : "Đã thu hồi")</span></div> } else if (k.HetHan is not null) { <div class="small">đến @k.HetHan?.ToString("dd/MM/yyyy")</div> }</td>
            <td class="small">@foreach (var p in k.DsPhamVi) { <span class="badge bg-light text-dark border me-1">@p</span> }</td>
            <td class="small">@(k.IpChoPhep ?? "Mọi IP")</td>
            <td class="small">@k.LanCuoi?.ToString("dd/MM HH:mm") @k.IpCuoi</td>
            <td class="text-nowrap"><a asp-action="NhatKy" asp-route-khoaApiId="@k.Id" class="btn btn-sm btn-link">Nhật ký</a>
                @if (k.DangHoatDong) { <form asp-action="ThuHoi" asp-route-id="@k.Id" method="post" class="d-inline" onsubmit="return confirm('Thu hồi khoá này?')"><button class="btn btn-sm btn-outline-danger">Thu hồi</button></form> }</td></tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có khoá API.</td></tr> }
    </tbody>
</table></div></div></div>
<div class="col-lg-4"><form asp-action="TaoKhoa" method="post" class="card"><div class="card-header">Tạo khoá mới</div><div class="card-body">
    <label class="form-label" for="ten">Tên hệ thống / mục đích</label><input name="ten" id="ten" class="form-control mb-2" placeholder="VD: HIS – báo hỏng; Agent máy trạm" required />
    <div class="form-label">Phạm vi quyền</div>
    @foreach (var (ma, ten) in PhamViApi.TatCa)
    {
        <div class="form-check"><input class="form-check-input" type="checkbox" name="phamVi" value="@ma" id="pv-@ma" /><label class="form-check-label small" for="pv-@ma">@ten <code>@ma</code></label></div>
    }
    <label class="form-label mt-2" for="ip">IP / dải được phép</label><input name="ipChoPhep" id="ip" class="form-control mb-1" placeholder="10.10.0.0/16, 10.20.1.5" />
    <div class="form-text mb-2">Để trống = mọi IP truy cập được ứng dụng. Nên giới hạn đúng máy chủ gọi API.</div>
    <label class="form-label" for="hetHan">Hết hạn (tuỳ chọn)</label><input name="hetHan" id="hetHan" type="date" class="form-control mb-3" />
    <button class="btn btn-primary w-100"><i class="bi bi-key"></i> Tạo khoá</button>
</div></form></div>
</div>
