@model BanQuyenPhanMem
@{ ViewData["Title"] = Model.Ten; }
<div class="small text-muted mb-1"><a asp-action="Index">Bản quyền phần mềm</a> › @Model.Ten</div>
<div class="page-head"><h1>@Model.Ten</h1>
    <span class="badge bg-@(Model.Loai != LoaiGiayPhep.MienPhi && Model.ConLai < 0 ? "danger" : "secondary")">@Model.DaDung / @(Model.Loai == LoaiGiayPhep.MienPhi ? "∞" : Model.SoLuong.ToString()) giấy phép</span>
    @if (User.LaCNTT()) { <div class="actions"><a asp-action="Form" asp-route-id="@Model.Id" class="btn btn-sm btn-primary"><i class="bi bi-pencil"></i> Sửa</a></div> }</div>
<div class="row g-3">
    <div class="col-lg-4"><div class="card"><div class="card-body"><dl class="info mb-0">
        <dt>Hãng</dt><dd>@Model.NhaSanXuat</dd><dt>Loại giấy phép</dt><dd>@Model.Loai.Ten()</dd>
        <dt>Ngày mua · hết hạn</dt><dd>@Model.NgayMua?.ToString("dd/MM/yyyy") · @(Model.NgayHetHan?.ToString("dd/MM/yyyy") ?? "không thời hạn")</dd>
        <dt>Hợp đồng</dt><dd>@if (Model.HopDong is not null) { <a asp-controller="HopDong" asp-action="Details" asp-route-id="@Model.HopDongId">@Model.HopDong.SoHopDong</a> }</dd>
        @if (User.LaCNTT() && Model.KhoaKichHoat is not null)
        {
            <dt>Khoá kích hoạt</dt><dd><details><summary class="small">Hiện khoá</summary><code class="user-select-all">@Model.KhoaKichHoat</code></details></dd>
        }
        <dt>Ghi chú</dt><dd>@Model.GhiChu</dd>
    </dl></div></div></div>
    <div class="col-lg-8"><div class="card"><div class="card-header">Đã cấp cho máy (@Model.DaDung)</div>
        <div class="table-responsive"><table class="table table-sm mb-0 align-middle">
            <thead><tr><th>Mã TS</th><th>Tên</th><th>Khoa</th><th>Ngày cấp</th><th></th></tr></thead>
            <tbody>@foreach (var c in Model.CapPhats.OrderBy(c => c.TaiSan?.MaTaiSan)) {
                <tr><td><a asp-controller="TaiSan" asp-action="Details" asp-route-id="@c.TaiSanId">@c.TaiSan?.MaTaiSan</a></td><td class="small">@c.TaiSan?.Ten</td><td class="small">@c.TaiSan?.KhoaPhong?.Ten</td>
                    <td class="small">@c.NgayCap.ToString("dd/MM/yyyy") · @c.NguoiCap</td>
                    <td class="text-end">@if (User.LaCNTT()) { <form asp-action="ThuHoi" asp-route-id="@Model.Id" method="post"><input type="hidden" name="capPhatId" value="@c.Id" /><button class="btn btn-sm btn-link text-danger p-0">Thu hồi</button></form> }</td></tr> }
            </tbody></table></div>
        @if (User.LaCNTT())
        {
            <form asp-action="CapPhat" asp-route-id="@Model.Id" method="post" class="card-footer bg-white d-flex gap-2">
                <input name="danhSachMa" class="form-control form-control-sm" placeholder="Mã tài sản, cách nhau bởi dấu phẩy" aria-label="Mã tài sản" required />
                <button class="btn btn-sm btn-outline-primary text-nowrap">Cấp phát</button>
            </form>
        }
    </div></div>
</div>
