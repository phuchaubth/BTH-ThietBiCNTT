@model (BaoCaoLanhDao B, SnapBaoCao S)
@{ var b = Model.B; var s = Model.S; }
<div class="card mb-3"><div class="card-header">1. Chỉ số hạ tầng CNTT quý @b.Ky (@b.TuNgay.ToString("dd/MM/yyyy") – @b.DenNgay.ToString("dd/MM/yyyy"))</div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Chỉ số</th><th class="text-end">Kết quả</th><th>Mục tiêu</th><th></th></tr></thead><tbody>
@foreach (var c in s.ChiSo) { <tr><td>@c.Ten <span class="small text-muted">@c.GhiChu</span></td><td class="text-end fw-semibold @(c.Dat == false ? "text-danger" : "")">@c.GiaTri</td><td class="small">@c.MucTieu</td><td>@(c.Dat == true ? "✓" : c.Dat == false ? "✗" : "")</td></tr> }</tbody></table></div></div>
<div class="card mb-3"><div class="card-header">2. Mọi sự cố hệ thống hoặc quy trình trong quý (@s.SuCo.Count) <span class="small fw-normal text-muted">GLD.04.01 ME2</span></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Loại</th><th>Mã / hệ thống</th><th>Thời điểm</th><th>Chi tiết</th></tr></thead><tbody>
@foreach (var x in s.SuCo) { <tr><td class="small">@x.Loai</td><td class="small">@x.Ma</td><td class="small">@x.Mo</td><td class="small">@x.ChiTiet</td></tr> }
@if (s.SuCo.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-2">Không ghi nhận sự cố nào trong quý.</td></tr> }</tbody></table></div>
    <div class="card-body small border-top">Sự cố an ninh mạng nghiêm trọng: <b>@s.SuCoAnNghiemTrong</b> · downtime ảnh hưởng an toàn người bệnh: <b>@s.SuKienAnToanNguoiBenh</b>@if (!string.IsNullOrWhiteSpace(b.SuCoNghiemTrong)) { <div class="mt-1" style="white-space:pre-line">@b.SuCoNghiemTrong</div> }</div></div>
<div class="card mb-3"><div class="card-header">3. Hành động cải thiện đã làm và theo dõi</div><div class="card-body small">
    <div class="fw-semibold">Hoàn thành và kiểm chứng hiệu quả trong quý (@s.HoanThanh.Count)</div><ul>@foreach (var h in s.HoanThanh) { <li>@h</li> }@if (s.HoanThanh.Count == 0) { <li class="text-muted">Không có.</li> }</ul>
    <div class="fw-semibold">Quá hạn, đang theo dõi (@s.HanhDong.Count)</div><ul class="mb-0">@foreach (var h in s.HanhDong) { <li><b>@h.Ma</b> @h.MoTa — @h.PhuTrach, hạn @h.Han (@h.TrangThai)</li> }@if (s.HanhDong.Count == 0) { <li class="text-muted">Không có.</li> }</ul></div></div>
<div class="card mb-3"><div class="card-header">4. Rủi ro Cao / Rất cao đang mở (@s.RuiRoCao.Count)</div><ul class="list-group list-group-flush small">@foreach (var r in s.RuiRoCao) { <li class="list-group-item">@r</li> }@if (s.RuiRoCao.Count == 0) { <li class="list-group-item text-muted">Không có.</li> }</ul></div>
<div class="card mb-3"><div class="card-header">5. Hạng mục cần Lãnh đạo quyết định (@s.CanQuyetDinh.Count)</div><ul class="list-group list-group-flush small">@foreach (var r in s.CanQuyetDinh) { <li class="list-group-item">@r</li> }@if (s.CanQuyetDinh.Count == 0) { <li class="list-group-item text-muted">Không có.</li> }</ul></div>
@if (!string.IsNullOrWhiteSpace(b.NhanXet)) { <div class="card mb-3"><div class="card-header">6. Nhận xét của Trưởng phòng CNTT (@b.NguoiGui, @b.NgayGui?.ToString("dd/MM/yyyy"))</div><div class="card-body" style="white-space:pre-line">@b.NhanXet</div></div> }
