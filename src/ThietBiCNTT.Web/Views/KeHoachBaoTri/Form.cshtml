@model KeHoachBaoTri
@{
    ViewData["Title"] = Model.Id == 0 ? "Lập kế hoạch bảo trì" : "Sửa kế hoạch bảo trì"; var vts = (List<VatTu>)ViewBag.VatTus;
}
<div class="small text-muted mb-1"><a asp-action="Index">Bảo trì định kỳ</a> › @ViewData["Title"]</div>
<div class="page-head"><h1>@ViewData["Title"]</h1></div>
@if (Model.Id != 0 && Model.TrangThai == TrangThaiKeHoach.HieuLuc) { <div class="alert alert-info small">Kế hoạch đang hiệu lực. Đổi phạm vi hoặc chu kỳ sẽ đưa kế hoạch về <b>Nháp</b> và phải trình duyệt lại; các thay đổi khác áp dụng ngay.</div> }
<form asp-action="Save" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger small"></div>
    <div class="row g-3">
    <div class="col-lg-7"><div class="card"><div class="card-header">Nội dung & phạm vi</div><div class="card-body row g-3">
        <div class="col-12"><label asp-for="Ten" class="form-label"></label><input asp-for="Ten" class="form-control" placeholder="VD: Vệ sinh máy in quý" /></div>
        <div class="col-md-6"><label asp-for="LoaiThietBiId" class="form-label"></label><select asp-for="LoaiThietBiId" asp-items="ViewBag.DsLoai" class="form-select" id="loai"><option value="">—</option></select></div>
        <div class="col-md-6"><label asp-for="KhoaPhongId" class="form-label"></label><select asp-for="KhoaPhongId" asp-items="ViewBag.DsKhoa" class="form-select"><option value="">Mọi khoa</option></select></div>
        <div class="col-12"><label asp-for="TaiSanId" class="form-label">Hoặc một tài sản cụ thể</label><select asp-for="TaiSanId" asp-items="ViewBag.DsTaiSan" class="form-select" id="taiSan"><option value="">—</option></select></div>
        <div class="col-md-4"><label asp-for="KieuChuKy" class="form-label"></label><select asp-for="KieuChuKy" asp-items="@EnumExtensions.ToSelectList<KieuChuKy>(Model.KieuChuKy)" class="form-select" id="kieu"></select></div>
        <div class="col-md-4 o-tg"><label asp-for="ChuKyNgay" class="form-label"></label><input asp-for="ChuKyNgay" class="form-control" id="chuKy" /><div class="form-text" id="goiY"></div></div>
        <div class="col-md-4 o-tg"><label asp-for="NgayTiepTheo" class="form-label"></label><input asp-for="NgayTiepTheo" type="date" class="form-control" /></div>
        <div class="col-md-4 o-cs"><label asp-for="ChuKyChiSo" class="form-label"></label><input asp-for="ChuKyChiSo" class="form-control" placeholder="20000" /></div>
        <div class="col-md-4 o-cs"><label asp-for="DonViChiSo" class="form-label"></label><input asp-for="DonViChiSo" class="form-control" placeholder="trang / giờ chạy" /></div>
        <div class="col-md-4"><label asp-for="NgayKetThuc" class="form-label"></label><input asp-for="NgayKetThuc" type="date" class="form-control" /></div>
        <div class="col-12 o-cs form-text mt-0">Theo chỉ số: lệnh sinh khi bộ đếm của thiết bị tăng đủ chu kỳ so với lần bảo trì trước (chỉ số ghi khi hoàn thành lệnh, qua API/agent hoặc sửa hồ sơ). Lần đầu theo "Ngày thực hiện tiếp theo".</div>
        <div class="col-md-8"><label asp-for="MauKiemTraId" class="form-label"></label><select asp-for="MauKiemTraId" asp-items="ViewBag.DsMau" class="form-select"><option value="">— Không (chỉ hướng dẫn văn bản) —</option></select>
            <div class="form-text">Mẫu Đạt/Không đạt, số đo có ngưỡng. KTV phải ghi checklist trước khi hoàn thành; mục không đạt tự tạo phiếu sửa chữa. Tạo mẫu ở <a asp-controller="KiemTra" asp-action="Mau">Kiểm tra thiết bị → Phiếu mẫu</a>.</div></div>
        <div class="col-md-4"><label asp-for="KyThuatVien" class="form-label"></label><select asp-for="KyThuatVien" asp-items="ViewBag.DsKtv" class="form-select"><option value="">— Giao sau —</option></select></div>
        <div class="col-12"><label asp-for="Checklist" class="form-label"></label><textarea asp-for="Checklist" rows="3" class="form-control"></textarea></div>
    </div></div></div>
    <div class="col-lg-5">
        <div class="card mb-3"><div class="card-header">Thẩm định & xét duyệt</div><div class="card-body row g-3">
            <div class="col-12"><label asp-for="NguoiThamDinh" class="form-label"></label><select asp-for="NguoiThamDinh" asp-items="ViewBag.DsKtv" class="form-select"><option value="">— Không cần thẩm định —</option></select></div>
            <div class="col-12"><label asp-for="NguoiDuyet" class="form-label"></label><select asp-for="NguoiDuyet" asp-items="ViewBag.DsNguoiDuyet" class="form-select"><option value="">— Chọn —</option></select>
                <div class="form-text">Chỉ kế hoạch đã duyệt (Hiệu lực) mới sinh lệnh bảo trì.</div></div>
        </div></div>
        <div class="card"><div class="card-header d-flex">Dự trù mỗi lần / thiết bị <button type="button" class="btn btn-sm btn-outline-primary ms-auto" id="themVt"><i class="bi bi-plus"></i> Vật tư</button></div><div class="card-body row g-3">
            <div class="col-6"><label asp-for="GioCongDuKien" class="form-label"></label><input asp-for="GioCongDuKien" type="number" step="0.25" min="0" class="form-control" /></div>
            <div class="col-6"><label asp-for="ChiPhiDuKien" class="form-label"></label><input asp-for="ChiPhiDuKien" type="number" step="1000" min="0" class="form-control" /></div>
            <div class="col-12"><table class="table table-sm mb-0"><tbody id="dsVt">
                @{ var i = 0; }
                @foreach (var v in Model.VatTus)
                {
                    <tr><td><select name="vatTu[@i].VatTuId" class="form-select form-select-sm" aria-label="Vật tư"><option value="">—</option>@foreach (var x in vts) { <option value="@x.Id" selected="@(x.Id == v.VatTuId)">@x.Ma – @x.Ten</option> }</select></td>
                        <td style="width:110px"><input name="vatTu[@i].SoLuong" type="number" step="any" min="0" value="@v.SoLuong.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm" aria-label="Số lượng" /></td></tr>
                    i++;
                }
            </tbody></table></div>
        </div></div>
    </div>
    </div>
    <div class="mt-3"><button class="btn btn-outline-primary"><i class="bi bi-save"></i> Lưu</button>
        @if (Model.TrangThai == TrangThaiKeHoach.Nhap) { <button class="btn btn-primary" name="guiTrinh" value="true"><i class="bi bi-send"></i> Lưu & gửi trình</button> }
        <a asp-action="Index" class="btn btn-link">Huỷ</a></div>
</form>
<template id="mauVt"><tr><td><select name="vatTu[#].VatTuId" class="form-select form-select-sm" aria-label="Vật tư"><option value="">—</option>@foreach (var x in vts) { <option value="@x.Id">@x.Ma – @x.Ten (@x.DonViTinh)</option> }</select></td>
    <td style="width:110px"><input name="vatTu[#].SoLuong" type="number" step="any" min="0" value="1" class="form-control form-control-sm" aria-label="Số lượng" /></td></tr></template>
@section Scripts {
<script>
(function () {
    const kieu = document.getElementById('kieu');
    const hien = () => { document.querySelectorAll('.o-cs').forEach(e => e.hidden = kieu.value === 'ThoiGian'); document.querySelectorAll('.o-tg').forEach(e => e.hidden = false); };
    kieu.onchange = hien; hien();
    const tb = document.getElementById('dsVt');
    document.getElementById('themVt').onclick = () => { tb.insertAdjacentHTML('beforeend', document.getElementById('mauVt').innerHTML.replaceAll('#', tb.rows.length)); };
    const goiY = async () => { const l = document.getElementById('loai').value, t = document.getElementById('taiSan').value; const o = document.getElementById('goiY');
        if (!l && !t) { o.textContent = ''; return; }
        const r = await (await fetch(`/KeHoachBaoTri/GoiYChuKy?loaiId=${l}&taiSanId=${t}`)).json();
        o.innerHTML = r.chuKy ? `Gợi ý: <a href="#" id="apGoiY">${r.chuKy} ngày</a> — ${r.lyDo}` : '';
        const a = document.getElementById('apGoiY'); if (a) a.onclick = e => { e.preventDefault(); document.getElementById('chuKy').value = r.chuKy; }; };
    document.getElementById('loai').onchange = goiY; document.getElementById('taiSan').onchange = goiY; goiY();
})();
</script>
}
