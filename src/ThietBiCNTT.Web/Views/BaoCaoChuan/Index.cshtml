@model IReadOnlyList<MauBaoCaoChuan>
@{
    ViewData["Title"] = "Báo cáo chuẩn"; var p = (ThamSoBaoCao)ViewBag.P;
    string Q(string ma, string dang) => $"/BaoCaoChuan/Xem?ma={ma}&dang={dang}&tu={p.Tu:yyyy-MM-dd}&den={p.Den:yyyy-MM-dd}&khoaId={p.KhoaId}&nam={p.Nam}&soNgay={p.SoNgay}";
}
<div class="page-head"><h1>Báo cáo</h1></div>
<partial name="_TabsBaoCao" />
<form method="get" class="card mb-3"><div class="card-body d-flex flex-wrap gap-2 align-items-end">
    <div><label class="form-label small mb-0" for="tu">Từ ngày</label><input type="date" id="tu" name="tu" value="@p.Tu.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
    <div><label class="form-label small mb-0" for="den">Đến ngày</label><input type="date" id="den" name="den" value="@p.Den.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
    <div><label class="form-label small mb-0" for="khoaId">Khoa/phòng</label><select id="khoaId" name="khoaId" asp-items="ViewBag.DsKhoa" class="form-select form-select-sm" style="width:220px"><option value="">Toàn bệnh viện</option></select></div>
    <div><label class="form-label small mb-0" for="nam">Năm ngân sách</label><input type="number" id="nam" name="nam" value="@p.Nam" class="form-control form-control-sm" style="width:90px" /></div>
    <div><label class="form-label small mb-0" for="soNgay">Sắp hết hạn trong</label><input type="number" id="soNgay" name="soNgay" value="@p.SoNgay" class="form-control form-control-sm" style="width:90px" /></div>
    <button class="btn btn-sm btn-outline-secondary">Áp dụng</button>
    <div class="small text-muted ms-auto">PDF in theo thể thức: quốc hiệu, tên đơn vị, địa danh – ngày, ô ký (cấu hình ở <i>Tham số → Báo cáo chuẩn</i>).</div>
</div></form>
<div class="card"><div class="table-responsive"><table class="table table-sm mb-0 align-middle">
    <thead><tr><th>Mã</th><th>Báo cáo</th><th>Tham số dùng</th><th class="text-end">Xuất</th></tr></thead>
    <tbody>@foreach (var m in Model) {
        <tr><td class="fw-semibold">@m.Ma</td><td><a href="@Q(m.Ma, "web")">@m.Ten</a><div class="small text-muted">@m.MoTa</div></td>
            <td class="small text-muted">@string.Join(", ", new[] { m.CanKy ? "kỳ" : null, m.CanKhoa ? "khoa" : null, m.CanNam ? "năm" : null, m.CanSoNgay ? "số ngày" : null }.Where(x => x is not null))</td>
            <td class="text-end text-nowrap"><a href="@Q(m.Ma, "pdf")" class="btn btn-sm btn-outline-danger"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
                <a href="@Q(m.Ma, "xlsx")" class="btn btn-sm btn-outline-success"><i class="bi bi-file-earmark-excel"></i> Excel</a></td></tr> }
    </tbody>
</table></div></div>
<div class="mt-3"><a asp-action="ThayThe" class="btn btn-sm btn-outline-primary"><i class="bi bi-arrow-repeat"></i> Đề nghị thay thế thiết bị (chọn & lập đề xuất mua sắm)</a></div>
