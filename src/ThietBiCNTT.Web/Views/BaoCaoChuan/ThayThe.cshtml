@model List<DeNghiThayThe>
@{ ViewData["Title"] = "Đề nghị thay thế thiết bị"; var tc = (TieuChiThayThe)ViewBag.TieuChi; var cntt = User.LaCNTT(); }
<div class="small text-muted mb-1"><a asp-action="Index">Báo cáo chuẩn</a> › Đề nghị thay thế</div>
<div class="page-head"><h1>Đề nghị thay thế thiết bị</h1>
    <div class="actions"><a href="/BaoCaoChuan/Xem?ma=BC04&dang=pdf&khoaId=@ViewBag.KhoaId" class="btn btn-sm btn-outline-danger"><i class="bi bi-file-earmark-pdf"></i> PDF (BC04)</a>
        <a href="/BaoCaoChuan/Xem?ma=BC04&dang=xlsx&khoaId=@ViewBag.KhoaId" class="btn btn-sm btn-outline-success"><i class="bi bi-file-earmark-excel"></i> Excel</a></div></div>
<div class="alert alert-light border small">Tiêu chí (Tham số → Đề nghị thay thế): quá tuổi thọ của loại thiết bị · hỏng ≥ <b>@tc.SoLanHong</b> lần/12 tháng · chi phí sửa chữa luỹ kế ≥ <b>@tc.TyLeChiPhi.ToString("0.#")%</b> nguyên giá ·
    HĐH hết hỗ trợ (@string.Join(", ", tc.HdhHetHoTro)) · RAM &lt; @tc.RamToiThieu.ToString("0.#") GB (máy tính) · đang hỏng. Hiện danh sách khi thoả từ <b>@tc.SoTieuChiToiThieu</b> tiêu chí.</div>
<form method="get" class="d-flex flex-wrap gap-2 mb-3">
    <select name="khoaId" asp-items="ViewBag.DsKhoa" class="form-select form-select-sm" style="width:220px" aria-label="Khoa"><option value="">Mọi khoa/phòng</option></select>
    <select name="loaiId" asp-items="ViewBag.DsLoai" class="form-select form-select-sm" style="width:200px" aria-label="Loại"><option value="">Mọi loại</option></select>
    <button class="btn btn-sm btn-outline-secondary">Lọc</button>
</form>
<form asp-action="LapDeXuat" method="post">
<div class="card"><div class="table-responsive"><table class="table table-sm table-hover mb-0 align-middle">
    <thead><tr>@if (cntt) { <th><input type="checkbox" class="form-check-input" onclick="document.querySelectorAll('.chon').forEach(c => c.checked = this.checked)" aria-label="Chọn tất cả" /></th> }
        <th>Tài sản</th><th>Khoa</th><th class="text-end">Tuổi/thọ</th><th class="text-end">Hỏng 12T</th><th class="text-end">Chi phí SC luỹ kế</th><th class="text-end">% NG</th><th>Lý do</th><th class="text-center">Điểm</th></tr></thead>
    <tbody>@foreach (var x in Model) {
        <tr>@if (cntt) { <td><input type="checkbox" name="taiSanId" value="@x.TaiSanId" class="form-check-input chon" aria-label="Chọn @x.MaTaiSan" /></td> }
            <td><a asp-controller="TaiSan" asp-action="Details" asp-route-id="@x.TaiSanId" class="fw-semibold">@x.MaTaiSan</a> <span class="small">@x.Ten</span><div class="small text-muted">@x.Loai</div></td>
            <td class="small">@(x.Khoa ?? "Kho CNTT")</td>
            <td class="text-end small">@x.TuoiNam?.ToString("0.#")/@x.TuoiTho</td><td class="text-end">@x.SoLanHong12T</td>
            <td class="text-end">@x.ChiPhiLuyKe.ToString("N0")</td><td class="text-end">@x.TyLeChiPhi?.ToString("0.#")</td>
            <td class="small">@foreach (var l in x.LyDo) { <span class="badge bg-warning-subtle text-warning-emphasis border me-1">@l</span> }</td>
            <td class="text-center"><span class="badge bg-@(x.Diem >= 3 ? "danger" : x.Diem == 2 ? "warning text-dark" : "secondary")">@x.Diem</span></td></tr> }
    @if (Model.Count == 0) { <tr><td colspan="9" class="text-center text-muted py-4">Không có thiết bị nào thoả tiêu chí.</td></tr> }
    </tbody>
</table></div></div>
@if (cntt && Model.Count > 0) { <button class="btn btn-primary btn-sm mt-2"><i class="bi bi-cart-plus"></i> Lập đề xuất mua sắm thay thế cho thiết bị đã chọn</button> }
</form>
