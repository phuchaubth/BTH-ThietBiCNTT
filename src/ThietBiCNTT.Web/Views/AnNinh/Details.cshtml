@model SuCoAnNinh
@{
    ViewData["Title"] = Model.Ma; bool xu = ViewBag.Xu; var lyDo = (List<string>)ViewBag.LyDoChuaDong; var hds = (List<HanhDongKhacPhuc>)ViewBag.HanhDong; int gio = ViewBag.Gio; var han = Model.HanBaoCao(gio);
    var moDong = Model.TrangThai != TrangThaiSuCoAn.DaDong; string Dt(DateTime t) => t.ToString("yyyy-MM-ddTHH:mm");
}
<div class="small text-muted mb-1"><a asp-action="Index">Sự cố an ninh mạng</a> › @Model.Ma</div>
<div class="page-head"><h1>@Model.Ma · @Model.Loai.Ten()</h1> @Html.Raw(Badge.Html(Model.TrangThai)) @if (Model.DaPhanLoai) { <span class="badge bg-@(Model.MucDo == MucDoAn.ThongThuong ? "secondary" : Model.MucDo == MucDoAn.NghiemTrong ? "warning text-dark" : "danger")">@Model.MucDo.Ten()</span> }
    @if (Model.LienQuanDuLieuCaNhan == true) { <span class="badge bg-dark">Liên quan dữ liệu cá nhân</span> }
    @if (xu && moDong) { <div class="actions"><a asp-controller="SuKienDowntime" asp-action="Create" asp-route-loai="DotXuat" asp-route-suCoId="@Model.Id" asp-route-heThongId="@Model.HeThongId" class="btn btn-sm btn-outline-danger">Mở sự kiện downtime</a></div> }</div>
@if (han is { } h && !Model.DaBaoCaoCoQuan) { <div class="alert @(h < DateTime.Now ? "alert-danger" : "alert-warning") py-2 small">Hạn báo cáo cơ quan chức năng: <b>@h.ToString("HH:mm dd/MM/yyyy")</b></div> }
<div class="row g-3"><div class="col-lg-8">
    <div class="card mb-3"><div class="card-body"><dl class="row info mb-0">
        <div class="col-12"><dt>Mô tả</dt><dd style="white-space:pre-line">@Model.MoTa</dd></div>
        <div class="col-sm-4"><dt>Nguồn</dt><dd>@Model.Nguon.Ten()</dd></div><div class="col-sm-4"><dt>Phát hiện</dt><dd>@Model.PhatHien.ToString("HH:mm dd/MM/yyyy")</dd></div><div class="col-sm-4"><dt>Người báo</dt><dd>@Model.NguoiBao</dd></div>
        <div class="col-sm-4"><dt>Hệ thống</dt><dd>@if (Model.HeThong is not null) { <a asp-controller="HeThong" asp-action="Details" asp-route-id="@Model.HeThongId">@Model.HeThong.Ma</a> }</dd></div>
        <div class="col-sm-4"><dt>Tài sản</dt><dd>@if (Model.TaiSan is not null) { <a asp-controller="TaiSan" asp-action="Details" asp-route-id="@Model.TaiSanId">@Model.TaiSan.MaTaiSan</a> }</dd></div>
        <div class="col-sm-4"><dt>Phụ trách</dt><dd>@Model.NguoiPhuTrach</dd></div>
        @if (Model.SuKienDowntime is not null) { <div class="col-12"><dt>Sự kiện downtime</dt><dd><a asp-controller="SuKienDowntime" asp-action="Details" asp-route-id="@Model.SuKienDowntimeId">@Model.SuKienDowntime.Ma</a></dd></div> }
        @if (Model.NguyenNhanGoc is not null) { <div class="col-md-6"><dt>Nguyên nhân gốc</dt><dd style="white-space:pre-line">@Model.NguyenNhanGoc</dd></div><div class="col-md-6"><dt>Bài học / cải thiện</dt><dd style="white-space:pre-line">@Model.BaiHoc</dd></div> }
        @if (Model.DaBaoCaoCoQuan) { <div class="col-12"><dt>Báo cáo cơ quan chức năng</dt><dd>@Model.CoQuan · số @Model.SoVanBan · @Model.NgayBaoCao?.ToString("dd/MM/yyyy")</dd></div> } else if (Model.LyDoKhongBaoCao is not null) { <div class="col-12"><dt>Lý do không báo cáo</dt><dd>@Model.LyDoKhongBaoCao</dd></div> }
    </dl></div></div>

    @if (xu && moDong)
    {
        <div class="card mb-3 border-primary"><div class="card-header">Phân mức & phân loại <span class="small fw-normal text-muted">FR-AN-02</span></div><div class="card-body">
        <form asp-action="PhanMuc" asp-route-id="@Model.Id" method="post" class="row g-2">
            <div class="col-md-3"><label class="form-label small mb-0" for="md">Mức độ</label><select id="md" name="mucDo" asp-items="@EnumExtensions.ToSelectList<MucDoAn>(Model.MucDo)" class="form-select form-select-sm"></select></div>
            <div class="col-md-3"><label class="form-label small mb-0" for="lo">Loại</label><select id="lo" name="loai" asp-items="@EnumExtensions.ToSelectList<LoaiSuCoAn>(Model.Loai)" class="form-select form-select-sm"></select></div>
            <div class="col-md-3"><label class="form-label small mb-0" for="lq">Liên quan dữ liệu cá nhân / người bệnh?</label><select id="lq" name="lienQuan" class="form-select form-select-sm"><option value="">— chọn —</option><option value="co" selected="@(Model.LienQuanDuLieuCaNhan == true)">Có</option><option value="khong" selected="@(Model.LienQuanDuLieuCaNhan == false)">Không</option></select></div>
            <div class="col-md-3"><label class="form-label small mb-0" for="nh">Phụ trách</label><select id="nh" name="nguoiPhuTrach" asp-items="ViewBag.DsNguoi" class="form-select form-select-sm"></select></div>
            <div class="col-md-6"><label class="form-label small mb-0" for="ht">Hệ thống bị ảnh hưởng</label><select id="ht" name="heThongId" asp-items="ViewBag.DsHeThong" class="form-select form-select-sm"><option value="">—</option></select></div>
            <div class="col-12"><button class="btn btn-sm btn-primary">Lưu phân mức</button> <span class="small text-muted">Nghiêm trọng trở lên: tự thông báo Trưởng phòng CNTT và Lãnh đạo.</span></div></form></div></div>
    }

    <div class="card mb-3"><div class="card-header">Các bước ứng phó <span class="small fw-normal text-muted">FR-AN-03</span></div><div class="card-body">
        <ul class="timeline small mb-2">
        @foreach (var b in Enum.GetValues<BuocUngPhoAn>())
        {
            var x = Model.Buocs.FirstOrDefault(y => y.Buoc == b);
            <li><b>@b.Ten()</b> @if (x is null) { <span class="text-muted">— chưa ghi</span> } else { <span class="badge @(x.HoanThanh ? "bg-success" : "bg-warning text-dark")">@(x.HoanThanh ? "xong" : "đang làm")</span> <span class="text-muted">@x.NguoiThucHien · @x.ThoiDiem.ToString("HH:mm dd/MM")</span><div style="white-space:pre-line">@x.NoiDung</div> }</li>
        }</ul>
        @if (xu && moDong && Model.DaPhanLoai)
        {
            <form asp-action="GhiBuoc" asp-route-id="@Model.Id" method="post" class="row g-2">
                <div class="col-md-3"><select name="buoc" asp-items="@EnumExtensions.ToSelectList<BuocUngPhoAn>()" class="form-select form-select-sm" aria-label="Bước"></select></div>
                <div class="col-md-7"><input name="noiDung" class="form-control form-control-sm" placeholder="Việc đã làm / kết quả (log, ảnh đính kèm bên dưới)" required /></div>
                <div class="col-md-1 align-self-center"><div class="form-check"><input class="form-check-input" type="checkbox" name="hoanThanh" value="true" id="ht2" checked /><label class="form-check-label small" for="ht2">xong</label></div></div>
                <div class="col-md-1"><button class="btn btn-sm btn-outline-primary w-100">Ghi</button></div></form>
        }
    </div></div>

    @if (xu && moDong && Model.NghiemTrongTroLen)
    {
        <div class="card mb-3"><div class="card-header">Báo cáo cơ quan chức năng & rút kinh nghiệm</div><div class="card-body small">
            <form asp-action="GhiBaoCao" asp-route-id="@Model.Id" method="post" class="row g-2 mb-3">
                <div class="col-md-4"><input name="coQuan" class="form-control form-control-sm" placeholder="Cơ quan nhận" /></div><div class="col-md-3"><input name="soVanBan" class="form-control form-control-sm" placeholder="Số văn bản" /></div>
                <div class="col-md-3"><input name="ngay" type="date" class="form-control form-control-sm" aria-label="Ngày" /></div><div class="col-md-2"><button class="btn btn-sm btn-outline-primary w-100">Ghi nhận báo cáo</button></div></form>
            <form asp-action="GhiBaoCao" asp-route-id="@Model.Id" method="post" class="d-flex gap-2 mb-3"><input name="lyDoKhong" class="form-control form-control-sm" placeholder="Hoặc: lý do không phải báo cáo" required /><button class="btn btn-sm btn-outline-secondary text-nowrap">Ghi lý do</button></form>
            <form asp-action="RutKinhNghiem" asp-route-id="@Model.Id" method="post" class="row g-2"><div class="col-md-6"><textarea name="nguyenNhan" class="form-control form-control-sm" rows="2" placeholder="Nguyên nhân gốc" required>@Model.NguyenNhanGoc</textarea></div><div class="col-md-6"><textarea name="baiHoc" class="form-control form-control-sm" rows="2" placeholder="Bài học / cải thiện" required>@Model.BaiHoc</textarea></div><div class="col-12"><button class="btn btn-sm btn-outline-primary">Lưu rút kinh nghiệm</button></div></form>
        </div></div>
    }
    @if (xu && moDong)
    {
        <div class="card mb-3"><div class="card-body">@if (lyDo.Count > 0) { <div class="alert alert-warning py-2 small">Chưa đóng được: @string.Join("; ", lyDo).</div> }
            <form asp-action="Dong" asp-route-id="@Model.Id" method="post"><button class="btn btn-success" disabled="@(lyDo.Count > 0)">Đóng sự cố</button></form></div></div>
    }
</div>
<div class="col-lg-4">
    <div class="card mb-3"><div class="card-header">Hành động khắc phục (@hds.Count)</div><div class="list-group list-group-flush small">
        @foreach (var hd in hds) { <a class="list-group-item list-group-item-action" asp-controller="HanhDong" asp-action="Details" asp-route-id="@hd.Id"><b>@hd.Ma</b> · @hd.MoTa <span class="text-muted">@hd.TrangThai.Ten()</span></a> }
        @if (hds.Count == 0) { <div class="list-group-item text-muted">Chưa có.</div> }</div>
        @if (xu) { <form asp-action="TaoHanhDong" asp-route-id="@Model.Id" method="post" class="card-footer bg-white"><textarea name="moTa" class="form-control form-control-sm mb-1" rows="2" placeholder="Hành động khắc phục / phòng ngừa" required></textarea><select name="nguoiChiuTrachNhiem" asp-items="ViewBag.DsNguoi" class="form-select form-select-sm mb-1"></select><button class="btn btn-sm btn-outline-primary">Tạo hành động</button></form> }</div>
    @await Html.PartialAsync("_DinhKem", (DoiTuong: "SuCoAnNinh", DoiTuongId: Model.Id.ToString(), Teps: (List<TepDinhKem>)ViewBag.Tep, DuocTaiLen: xu && moDong))
</div></div>
